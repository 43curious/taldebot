# Local commands use this file, even when remote credentials are present.
LOCAL_DATABASE_URL=file:sqlite.db

# Required for deployed runtime and commands explicitly passed --remote.
TURSO_CONNECTION_URL=
TURSO_AUTH_TOKEN=

# Required only by db:admin. Never committed or printed by the command.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# Optional: without SMTP_HOST notifications are simulated locally.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
