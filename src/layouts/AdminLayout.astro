---
import Layout from "./Layout.astro";
import AdminNav from "../components/AdminNav.astro";

interface Props {
    title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;
---

<Layout title={title}>
    <div class="min-h-screen bg-slate-50">
        <AdminNav currentPath={currentPath} />
        <div id="admin-content" class="min-h-screen transition-all duration-200 lg:pl-64">
            <button
                id="mobile-menu-button"
                type="button"
                class="fixed left-4 top-4 z-30 flex h-10 w-10 items-center justify-center rounded-xl bg-white text-slate-600 shadow-lg ring-1 ring-slate-200 lg:hidden"
                aria-label="Nabigazio menua ireki"
                aria-expanded="false"
            >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
            </button>
            <div class="py-10 pt-20 lg:pt-10">
                <main>
                    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
                        <slot />
                    </div>
                </main>
            </div>
        </div>
    </div>
</Layout>
