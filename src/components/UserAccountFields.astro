---
import type { classes, degrees } from '../../db/schema';
interface Props {
    account: {
        username: string;
        fullName: string;
        email: string;
        role: string;
        degreeIds: string[];
        classIds: string[];
    };
    allDegrees: (typeof degrees.$inferSelect)[];
    allClasses: (typeof classes.$inferSelect)[];
    creating?: boolean;
    self?: boolean;
}
const { account, allDegrees, allClasses, creating, self } = Astro.props;
---

<div class="grid gap-4 sm:grid-cols-2">
    <label class="teacher-label">
        Erabiltzailea
        <input
            name="username"
            required
            autocomplete="off"
            value={account.username}
        />
    </label>
    <label class="teacher-label">
        Izen-abizenak
        <input name="fullName" value={account.fullName} />
    </label>
    <label class="teacher-label">
        Emaila
        <input name="email" type="email" value={account.email} />
    </label>
    <label class="teacher-label">
        Rola
        {self && <input type="hidden" name="role" value="master" />}
        <select name="role" disabled={self}>
            <option value="admin" selected={account.role === 'admin'}>
                Irakaslea
            </option>
            <option value="master" selected={account.role === 'master'}>
                Master
            </option>
        </select>
    </label>
    {creating && (
        <label class="teacher-label">
            Pasahitza
            <input
                type="password"
                name="password"
                required
                autocomplete="new-password"
            />
        </label>
    )}
</div>
<fieldset class="mt-5">
    <legend class="teacher-label">Egungo irakaskuntza-ardurak</legend>
    <p class="mt-2 text-xs text-slate-500">
        Gradu batek bere klase guztietarako sarbidea ematen du; klase batek
        hautatutako klaserako bakarrik. Masterrak sarbide osoa du. Gordetako
        ardurak irakasle rolarako erabiltzen dira.
    </p>
    <div class="mt-3 grid gap-4 sm:grid-cols-2">
        <fieldset>
            <legend class="teacher-label">Graduak</legend>
            {allDegrees.map((degree) => (
                <label class="flex min-h-11 items-center gap-2 text-sm">
                    <input
                        type="checkbox"
                        name="degreeId"
                        value={degree.id}
                        checked={account.degreeIds.includes(String(degree.id))}
                    />
                    {degree.name}
                </label>
            ))}
            {!allDegrees.length && (
                <p class="mt-2 text-xs text-slate-500">Ez dago gradurik.</p>
            )}
        </fieldset>
        <fieldset>
            <legend class="teacher-label">Klaseak</legend>
            {allClasses.map((group) => (
                <label class="flex min-h-11 items-center gap-2 text-sm">
                    <input
                        type="checkbox"
                        name="classId"
                        value={group.id}
                        checked={account.classIds.includes(String(group.id))}
                    />
                    {
                        allDegrees.find(
                            (degree) => degree.id === group.degreeId,
                        )?.name
                    }{' '}
                    · {group.name} · {group.year}. maila
                </label>
            ))}
            {!allClasses.length && (
                <p class="mt-2 text-xs text-slate-500">Ez dago klaserik.</p>
            )}
        </fieldset>
    </div>
</fieldset>
