---
import Layout from '../layouts/Layout.astro';
import '../styles/teacher.css';
import '../styles/survey.css';
import { t, studentPath, type Language } from '../lib/i18n';

interface Props {
    lang: Language;
}
const { lang } = Astro.props;
const tr = t(lang);
---

<Layout title={tr.confirmation.title} lang={lang}>
    <main class="teacher-page survey-page min-h-screen flex items-center justify-center">
        <div class="teacher-panel max-w-md w-full p-6 text-center">
            <div class="w-10 h-10 bg-teal-50 text-teal-700 rounded-lg flex items-center justify-center mx-auto mb-6">
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-5 w-5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width={2}
                        d="M5 13l4 4L19 7"
                    ></path>
                </svg>
            </div>
            <h1 class="text-slate-900 mb-4">{tr.confirmation.title}</h1>
            <p class="text-slate-600 mb-8">{tr.confirmation.message}</p>
            <div class="space-y-4">
                <p class="text-sm text-slate-500">{tr.confirmation.canClose}</p>
                <a href={studentPath(lang)} class="teacher-button">
                    {tr.confirmation.backHome}
                </a>
            </div>
        </div>
    </main>
</Layout>
