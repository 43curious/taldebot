---
import { db } from "../lib/db";
import { students, responses } from "../../db/schema";
import { inArray } from "drizzle-orm";

interface Props {
    teamNumber: number;
    memberIds: number[];
    justification: string;
}

const { teamNumber, memberIds, justification } = Astro.props;

const memberData = await db.query.students.findMany({
    where: inArray(students.id, memberIds),
});

const memberResponses = await db.query.responses.findMany({
    where: inArray(responses.studentId, memberIds),
});

const membersWithSkills = memberData.map((m) => {
    const resp = memberResponses.find((r) => r.studentId === m.id);
    if (!resp) return { ...m, topSkills: [] };

    const allSkills = [
        ...Object.entries(resp.skillsNarrative).map(([k, v]) => ({
            name: k,
            val: v,
            cat: "Narratiba",
        })),
        ...Object.entries(resp.skillsTechnical).map(([k, v]) => ({
            name: k,
            val: v,
            cat: "Teknika",
        })),
        ...Object.entries(resp.skillsManagement).map(([k, v]) => ({
            name: k,
            val: v,
            cat: "Kudeaketa",
        })),
    ];

    const topSkills = allSkills.sort((a, b) => b.val - a.val).slice(0, 3);
    return { ...m, topSkills };
});
const skillLabels: Record<string, string> = { creativity: "Sormena", writing: "Idazketa", references: "Erreferentziak", communication: "Komunikazioa", camera: "Kamera", sound: "Soinua", editing: "Edizioa", planning: "Plangintza", production: "Ekoizpena" };
---

<article class="teacher-panel flex flex-col">
    <header class="flex items-center justify-between gap-3 border-b border-slate-100 px-5 py-4">
        <h2 class="text-sm text-slate-900">{teamNumber}. taldea</h2><span class="text-xs text-slate-500">{membersWithSkills.length} kide</span>
    </header>
    <ul class="divide-y divide-slate-100 px-5">
        {membersWithSkills.map(member => <li class="py-3 text-sm text-slate-800">{member.name}{member.isExcluded && <span class="ml-2 text-xs text-slate-400">Absent</span>}</li>)}
    </ul>
    <details class="mt-auto border-t border-slate-100 px-5 py-3 print:hidden">
        <summary class="flex cursor-pointer items-center justify-between text-xs text-slate-500">Gaitasunak eta azalpena <span aria-hidden="true">⌄</span></summary>
        <ul class="mt-3 space-y-3">
            {membersWithSkills.map(member => <li><p class="text-xs font-medium text-slate-700">{member.name}</p><p class="mt-1 text-xs leading-relaxed text-slate-500">{member.topSkills.map(skill => `${skillLabels[skill.name] || skill.name} (${skill.val})`).join(' · ') || 'Batez besteko profila'}</p></li>)}
        </ul>
        <p class="mt-4 border-t border-slate-100 pt-3 text-xs leading-relaxed text-slate-500 whitespace-pre-line">{justification}</p>
    </details>
</article>
