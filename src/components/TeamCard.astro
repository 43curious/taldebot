---
import type { TeamMember } from '../lib/projectData';
interface Props {
    teamNumber: number;
    membersWithSkills: TeamMember[];
    justification: string;
    towns?: Map<number, string | null>;
}
const { teamNumber, membersWithSkills, justification, towns } = Astro.props;
---

<article class="teacher-panel flex flex-col">
    <header class="flex items-center justify-between gap-3 border-b border-slate-100 px-5 py-4">
        <h2 class="text-sm text-slate-900">{teamNumber}. taldea</h2>
        <span class="text-xs text-slate-500">
            {membersWithSkills.length} kide
        </span>
    </header>
    <ul class="divide-y divide-slate-100 px-5">
        {membersWithSkills.map((member) => (
            <li class="py-3 text-sm text-slate-800">
                {member.name}
                {towns && (
                    <span class="ml-2 text-xs text-slate-500">
                        {towns.get(member.id) || 'Kokapen ezezaguna'}
                    </span>
                )}
                {member.isExcluded && (
                    <span class="ml-2 text-xs text-slate-400">Absent</span>
                )}
            </li>
        ))}
    </ul>
    <details class="mt-auto border-t border-slate-100 px-5 py-3 print:hidden">
        <summary class="flex cursor-pointer items-center justify-between text-xs text-slate-500">
            Gaitasunak eta azalpena <span aria-hidden="true">⌄</span>
        </summary>
        <ul class="mt-3 space-y-3">
            {membersWithSkills.map((member) => (
                <li>
                    <p class="text-xs font-medium text-slate-700">
                        {member.name}
                    </p>
                    <p class="mt-1 text-xs leading-relaxed text-slate-500">
                        {member.topSkills
                            .map((skill) => `${skill.label} (${skill.val})`)
                            .join(' · ') || 'Autoebaluaziorik gabe'}
                    </p>
                </li>
            ))}
        </ul>
        <p class="mt-4 border-t border-slate-100 pt-3 text-xs leading-relaxed text-slate-500 whitespace-pre-line">
            {justification}
        </p>
    </details>
</article>
