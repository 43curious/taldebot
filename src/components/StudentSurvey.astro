---
import Layout from '../layouts/Layout.astro';
import { SkillSlider } from './SkillSlider';
import { GroupDynamics } from './GroupDynamics';
import { t, type Language } from '../lib/i18n';
import { localizedSkillGroups } from '../lib/skills';
import type { SurveyData } from '../lib/survey';
import '../styles/teacher.css';
import '../styles/survey.css';
interface Props {
    project: Pick<SurveyData['project'], 'id' | 'name'>;
    allStudents: Pick<
        SurveyData['allStudents'][number],
        'id' | 'name' | 'studentRecordId' | 'hasCompleted' | 'isExcluded'
    >[];
    lang: Language;
    initialStudentId: string | null;
    requestToken: string;
    mode?: 'live' | 'trial';
}
const {
    lang,
    project,
    allStudents,
    initialStudentId,
    requestToken,
    mode = 'live',
} = Astro.props;
const trial = mode === 'trial';
const tr = t(lang);
const groups = localizedSkillGroups(lang);
const activeStudents = allStudents.filter((student) => !student.isExcluded);
const headings = [
    tr.form.section1Title,
    tr.form.section2Title,
    tr.form.section3Title,
    tr.form.section4Title,
];
---

<Layout lang={lang} title={`${tr.form.title}: ${project.name}`}>
    <main class="survey-page teacher-page mx-auto max-w-3xl">
        {trial && (
            <div class="mb-6 flex items-center justify-between gap-4">
                <a
                    href="/admin/dashboard"
                    class="inline-flex min-h-11 items-center text-sm text-slate-500 hover:text-teal-700"
                >
                    ← {tr.surveyUi.admin}
                </a>
                <details class="survey-trial-info teacher-menu">
                    <summary
                        aria-label={tr.surveyUi.trialTitle}
                        title={tr.surveyUi.trialTitle}
                    >
                        <svg
                            aria-hidden="true"
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-5 w-5"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.5"
                        >
                            <circle cx="12" cy="12" r="9" />
                            <path stroke-linecap="round" d="M12 11v6" />
                            <circle
                                cx="12"
                                cy="7"
                                r=".75"
                                fill="currentColor"
                                stroke="none"
                            />
                        </svg>
                    </summary>
                    <aside
                        class="survey-trial-note"
                        aria-label={tr.surveyUi.trialTitle}
                    >
                        <p class="text-sm font-semibold text-slate-900">
                            {tr.surveyUi.trialTitle}
                        </p>
                        <p class="mt-2 text-sm leading-relaxed text-slate-600">
                            {tr.surveyUi.trialNote}
                        </p>
                        <nav
                            class="teacher-tabs mt-3"
                            aria-label={
                                lang === 'en' ? 'Language' : 'Hizkuntza'
                            }
                        >
                            <a
                                href="/admin/survey-trial?lang=eu"
                                aria-current={
                                    lang === 'eu' ? 'page' : undefined
                                }
                            >
                                Euskara
                            </a>
                            <a
                                href="/admin/survey-trial?lang=en"
                                aria-current={
                                    lang === 'en' ? 'page' : undefined
                                }
                            >
                                English
                            </a>
                        </nav>
                    </aside>
                </details>
            </div>
        )}
        <header class="mb-6">
            <p class="mb-2 text-xs text-slate-500">
                TaldeBOT · {tr.form.title}
            </p>
            <h1>{project.name}</h1>
        </header>
        <form
            id="student-form"
            action={
                trial ? '/api/admin/trial-survey' : '/api/student/submit-form'
            }
            method="POST"
            class="teacher-panel space-y-5 p-4 sm:p-6"
            data-lang={lang}
            data-mode={mode}
        >
            <input type="hidden" name="requestToken" value={requestToken} />
            <input type="hidden" name="studentId" value={initialStudentId} />
            <input type="hidden" name="projectId" value={project.id} />
            <input type="hidden" name="lang" value={lang} />
            <p
                data-submission-error
                role="alert"
                tabindex="-1"
                class="text-sm text-red-700"
                hidden
            ></p>
            <div>
                <p data-progress-label class="mb-3 text-xs text-slate-500"></p>
                <div
                    id="progress-bar"
                    class="flex gap-2"
                    role="progressbar"
                    aria-label={tr.surveyUi.progress}
                    aria-valuemin="1"
                    aria-valuemax="4"
                    aria-valuenow="1"
                >
                    {headings.map((_, index) => (
                        <div
                            class:list={[
                                'h-1 flex-1 rounded-full',
                                index === 0 ? 'bg-teal-600' : 'bg-slate-200',
                            ]}
                        />
                    ))}
                </div>
            </div>
            {headings.map((heading, index) => (
                <section
                    id={`section-${index + 1}`}
                    hidden={index !== 0}
                    aria-labelledby={`section-heading-${index + 1}`}
                >
                    <h2
                        id={`section-heading-${index + 1}`}
                        tabindex="-1"
                        class="mb-3 text-xl font-semibold tracking-tight text-slate-900"
                    >
                        {heading}
                    </h2>
                    <p
                        id={`section-description-${index + 1}`}
                        class="mb-6 whitespace-pre-line text-sm leading-relaxed text-slate-600"
                    >
                        {
                            tr.sectionDescriptions[
                                String(
                                    index + 1,
                                ) as keyof typeof tr.sectionDescriptions
                            ]
                        }
                    </p>
                    {index > 1 && (
                        <p class="survey-scale-note mb-6 text-xs text-slate-500">
                            {tr.surveyUi.scale}
                        </p>
                    )}
                    {index === 0 && (
                        <>
                            <div class="space-y-5">
                                <label
                                    class="teacher-label"
                                    for="studentSelect"
                                >
                                    {trial
                                        ? tr.form.selectName
                                        : lang === 'en'
                                          ? 'Your name'
                                          : 'Zure izena'}
                                    <select
                                        id="studentSelect"
                                        required
                                        disabled={!trial}
                                        class="w-full"
                                    >
                                        <option value="">
                                            {tr.form.selectPlaceholder}
                                        </option>
                                        {activeStudents
                                            .filter(
                                                (student) =>
                                                    trial ||
                                                    String(student.id) ===
                                                        initialStudentId,
                                            )
                                            .map((student) => (
                                                <option
                                                    value={student.id}
                                                    disabled={Boolean(
                                                        student.hasCompleted,
                                                    )}
                                                    selected={
                                                        initialStudentId ===
                                                        String(student.id)
                                                    }
                                                >
                                                    {student.name}
                                                </option>
                                            ))}
                                    </select>
                                </label>
                                <div>
                                    <label
                                        for="emailPrefix"
                                        class="teacher-label mb-2"
                                    >
                                        {tr.form.academicEmail}
                                    </label>
                                    <div class="survey-email flex items-center rounded-lg border border-slate-200 bg-white">
                                        <input
                                            type="text"
                                            name="emailPrefix"
                                            id="emailPrefix"
                                            required
                                            placeholder={
                                                tr.form.emailPlaceholder
                                            }
                                            class="min-w-0 flex-1"
                                        />
                                        <span class="shrink-0 pr-3 text-xs text-slate-500">
                                            @alumni.mondragon.edu
                                        </span>
                                    </div>
                                    <input
                                        type="hidden"
                                        name="email"
                                        id="fullEmail"
                                    />
                                </div>
                                <label
                                    class="flex min-h-11 items-start gap-3 text-sm leading-relaxed text-slate-600"
                                    for="terms"
                                >
                                    <input
                                        id="terms"
                                        name="terms"
                                        type="checkbox"
                                        required
                                        class="mt-1 shrink-0"
                                    />
                                    <span>{tr.form.termsDescription}</span>
                                </label>
                                <button
                                    type="button"
                                    id="openDisclaimer"
                                    class="inline-flex min-h-11 items-center text-sm text-teal-700"
                                >
                                    {tr.form.termsLink}
                                </button>
                            </div>
                            <dialog
                                id="disclaimerModal"
                                class="w-[calc(100%-2rem)] max-w-lg rounded-xl border border-slate-200 bg-white p-5 sm:p-6"
                                aria-labelledby="disclaimer-heading"
                            >
                                <h3
                                    id="disclaimer-heading"
                                    class="mb-4 text-lg font-semibold text-slate-900"
                                >
                                    {tr.form.disclaimerTitle}
                                </h3>
                                <div class="space-y-3 text-sm leading-relaxed text-slate-600">
                                    <p>{tr.form.disclaimerP1}</p>
                                    <p>
                                        <strong>{tr.form.disclaimerP2}</strong>{' '}
                                        {tr.form.disclaimerP2Content}
                                    </p>
                                    <p>{tr.form.disclaimerP3}</p>
                                </div>
                                <button
                                    type="button"
                                    id="closeDisclaimer"
                                    class="teacher-button mt-5"
                                >
                                    {tr.form.disclaimerClose}
                                </button>
                            </dialog>
                            <div class="mt-6 flex justify-end">
                                <button
                                    type="button"
                                    id="btn-next-1"
                                    data-next="2"
                                    class="teacher-button teacher-button-primary"
                                    disabled
                                >
                                    {tr.form.nextSection}
                                </button>
                            </div>
                        </>
                    )}
                    {index === 1 && (
                        <GroupDynamics
                            client:load
                            options={allStudents
                                .filter(
                                    (student) =>
                                        student.studentRecordId !== null,
                                )
                                .map((student) => ({
                                    id: student.id,
                                    name: student.name,
                                }))}
                            studentId={
                                initialStudentId
                                    ? Number(initialStudentId)
                                    : undefined
                            }
                            lang={lang}
                        />
                    )}
                    {index === 2 && (
                        <div class="space-y-6">
                            {groups.slice(0, 3).map((group) => (
                                <div
                                    class="survey-skill-group"
                                    aria-labelledby={`skills-${group.prefix}`}
                                >
                                    <h3
                                        id={`skills-${group.prefix}`}
                                        class="survey-skill-heading"
                                    >
                                        {group.label}
                                    </h3>
                                    <div class="survey-skill-grid">
                                        {group.skills.map((skill) => (
                                            <div class="survey-skill-item">
                                                <SkillSlider
                                                    client:load
                                                    label={skill.label}
                                                    name={skill.name}
                                                    description={
                                                        skill.description
                                                    }
                                                />
                                            </div>
                                        ))}
                                    </div>
                                </div>
                            ))}
                        </div>
                    )}
                    {index === 3 && (
                        <div class="survey-skill-group">
                            <div class="survey-skill-grid">
                                {groups[3].skills.map((skill) => (
                                    <div class="survey-skill-item">
                                        <SkillSlider
                                            client:load
                                            label={skill.label}
                                            name={skill.name}
                                            description={skill.description}
                                        />
                                    </div>
                                ))}
                            </div>
                        </div>
                    )}
                    {index > 0 && (
                        <div class="mt-8 flex flex-wrap justify-between gap-3 border-t border-slate-100 pt-5">
                            <button
                                type="button"
                                data-prev={index}
                                class="teacher-button"
                            >
                                {tr.form.back}
                            </button>
                            {index < 3 ? (
                                <button
                                    type="button"
                                    data-next={index + 2}
                                    class="teacher-button teacher-button-primary"
                                >
                                    {tr.form.nextSection}
                                </button>
                            ) : (
                                <button
                                    type="submit"
                                    class="teacher-button teacher-button-primary"
                                >
                                    {tr.form.submit}
                                </button>
                            )}
                        </div>
                    )}
                </section>
            ))}
        </form>
        {trial && (
            <section
                id="trial-complete"
                class="teacher-panel p-5 sm:p-6"
                role="status"
                tabindex="-1"
                hidden
            >
                <h2 class="text-lg">{tr.surveyUi.trialDone}</h2>
                <p class="mt-3 text-sm text-slate-600">
                    {tr.surveyUi.trialDoneNote}
                </p>
                <div class="teacher-toolbar mt-5">
                    <a
                        href={`/admin/survey-trial?lang=${lang}`}
                        class="teacher-button teacher-button-primary"
                    >
                        {tr.surveyUi.restart}
                    </a>
                    <a href="/admin/dashboard" class="teacher-button">
                        {tr.surveyUi.admin}
                    </a>
                </div>
            </section>
        )}
    </main>
    <script>
        import '../scripts/studentSurvey';
    </script>
</Layout>
