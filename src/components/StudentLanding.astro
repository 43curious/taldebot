---
import Layout from '../layouts/Layout.astro';
import { t, type Language } from '../lib/i18n';
interface Props {
    lang: Language;
}
const { lang } = Astro.props;
const tr = t(lang);
---

<Layout title="TaldeBOT" lang={lang}>
    <div class="landing-page" data-lang={lang}>
        <header class="landing-header">
            <nav
                class="landing-nav"
                aria-label={
                    lang === 'en' ? 'Main navigation' : 'Nabigazio nagusia'
                }
            >
                <a
                    class="landing-brand"
                    href={lang === 'en' ? '/en/' : '/'}
                    aria-label="TaldeBOT"
                >
                    <span class="landing-logo" aria-hidden="true">
                        <svg
                            viewBox="0 0 24 24"
                            width="24"
                            height="24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            stroke-linecap="round"
                        >
                            <circle cx="12" cy="7" r="3" />
                            <path d="M6 20v-2a6 6 0 0 1 12 0v2M18 5a3 3 0 0 1 0 6M20 20v-2a6 6 0 0 0-2-4M6 5a3 3 0 0 0 0 6M4 20v-2a6 6 0 0 1 2-4" />
                        </svg>
                    </span>
                    <span>
                        Talde<span class="landing-accent">BOT</span>
                    </span>
                </a>
                <div class="landing-actions">
                    <label class="sr-only" for="lang-selector">
                        {lang === 'en' ? 'Language' : 'Hizkuntza'}
                    </label>
                    <select id="lang-selector">
                        <option value="eu" selected={lang === 'eu'}>
                            EUS
                        </option>
                        <option value="en" selected={lang === 'en'}>
                            EN
                        </option>
                    </select>
                    <a
                        href="/admin/login"
                        class="landing-admin"
                        aria-label={tr.landing.adminAccess}
                        title={tr.landing.adminAccess}
                    >
                        <svg
                            aria-hidden="true"
                            viewBox="0 0 24 24"
                            width="20"
                            height="20"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.7"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path d="M10 17l5-5-5-5M15 12H3M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
                        </svg>
                        <span class="landing-admin-label">
                            {tr.landing.adminAccess}
                        </span>
                    </a>
                </div>
            </nav>
        </header>
        <main class="landing-main">
            <section class="landing-content" aria-labelledby="landing-title">
                <div class="landing-intro">
                    <h1 id="landing-title">
                        Talde<span class="landing-accent">BOT</span>
                    </h1>
                    <p>{tr.landing.tagline}</p>
                </div>
                <form
                    id="project-code-form"
                    class="landing-code-panel"
                    data-lang={lang}
                >
                    <fieldset aria-describedby="code-help">
                        <legend class="sr-only">{tr.landing.codeLabel}</legend>
                        <div id="otp-container" class="landing-code-fields">
                            {[1, 2, 3, 4].map((position) => (
                                <input
                                    class="otp-input"
                                    type="text"
                                    inputmode="numeric"
                                    pattern="[0-9]"
                                    maxlength="1"
                                    required
                                    placeholder={String(position)}
                                    aria-label={`${tr.landing.digitLabel} ${position}`}
                                    autocomplete={
                                        position === 1 ? 'one-time-code' : 'off'
                                    }
                                />
                            ))}
                            <span
                                class="landing-code-separator"
                                aria-hidden="true"
                            >
                                –
                            </span>
                            <input
                                class="otp-input landing-code-letter"
                                type="text"
                                inputmode="text"
                                pattern="[A-Za-z]"
                                maxlength="1"
                                required
                                placeholder="A"
                                aria-label={tr.landing.letterLabel}
                                autocomplete="off"
                                autocapitalize="characters"
                                spellcheck="false"
                            />
                        </div>
                        <p id="code-help" class="sr-only">
                            {tr.landing.codeHint}
                        </p>
                    </fieldset>
                    <p id="error-message" role="alert" hidden>
                        {tr.landing.codeError}
                    </p>
                    <button id="hasi-button" type="submit" disabled>
                        {tr.landing.start}
                        <svg
                            aria-hidden="true"
                            viewBox="0 0 24 24"
                            width="24"
                            height="24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="3"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path d="M5 12h14M12 5l7 7-7 7" />
                        </svg>
                    </button>
                </form>
            </section>
        </main>
        <footer class="landing-footer">
            &copy; {new Date().getFullYear()} TaldeBOT · MU
        </footer>
    </div>
</Layout>
<script>
    import '../scripts/studentLanding';
</script>
<style>
    .landing-page {
        min-height: 100svh;
        display: flex;
        flex-direction: column;
        background: #f8fafc;
        color: #0f172a;
    }
    .landing-header {
        padding: 1rem;
        border-bottom: 1px solid #e2e8f0;
        background: #fff;
    }
    .landing-nav {
        max-width: 72rem;
        margin-inline: auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
    }
    .landing-brand {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        min-height: 44px;
        font-size: 1.3rem;
        font-weight: 700;
        letter-spacing: -0.04em;
    }
    .landing-logo {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: grid;
        place-items: center;
        background: #0d9488;
        color: #fff;
    }
    .landing-accent {
        color: #0d9488;
    }
    .landing-actions {
        display: flex;
        align-items: center;
        flex-shrink: 0;
        gap: 0.5rem;
    }
    .landing-actions select {
        min-height: 44px;
        max-width: 5rem;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 0.5rem;
        background: #fff;
        color: #475569;
        font-size: 0.8rem;
    }
    .landing-admin {
        min-width: 44px;
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        border-radius: 8px;
        color: #475569;
        font-size: 0.85rem;
    }
    .landing-admin:hover {
        background: #f0fdfa;
        color: #0f766e;
    }
    .landing-admin-label {
        display: none;
    }
    .landing-main {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: clamp(1.75rem, 6vh, 4rem) 1rem;
    }
    .landing-content {
        width: 100%;
        max-width: 34rem;
    }
    .landing-intro {
        margin-bottom: clamp(1.5rem, 5vh, 2.5rem);
        text-align: center;
    }
    .landing-intro h1 {
        font-size: clamp(2.75rem, 10vw, 4.5rem);
        font-weight: 700;
        letter-spacing: -0.06em;
        line-height: 1.1;
    }
    .landing-intro p {
        margin: 1rem auto 0;
        max-width: 28rem;
        font-size: clamp(1rem, 3.5vw, 1.25rem);
        font-style: italic;
        line-height: 1.6;
        color: #64748b;
    }
    .landing-code-panel {
        max-width: 26rem;
        margin-inline: auto;
    }
    .landing-code-panel fieldset {
        min-width: 0;
    }
    .landing-code-fields {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr)) 0.8rem minmax(0, 1fr);
        gap: clamp(0.5rem, 2vw, 0.75rem);
        align-items: center;
    }
    .otp-input {
        width: 100%;
        min-width: 0;
        height: clamp(3.5rem, 16vw, 5rem);
        padding: 0;
        border: 2px solid #e2e8f0;
        border-radius: 16px;
        background: #fff;
        color: #0f172a;
        font-size: clamp(1.75rem, 7vw, 1.875rem);
        font-weight: 900;
        font-variant-numeric: tabular-nums;
        text-align: center;
        caret-color: #0f766e;
        box-shadow:
            0 10px 15px -3px rgb(226 232 240 / 50%),
            0 4px 6px -4px rgb(226 232 240 / 50%);
        transition:
            border-color 0.2s,
            box-shadow 0.2s;
    }
    .otp-input::placeholder {
        color: #9ca3af;
        opacity: 1;
    }
    .otp-input:focus::placeholder {
        color: transparent;
    }
    .otp-input.filled {
        background: #f8fafc;
        border-color: #0d9488;
        color: #0d9488;
    }
    .landing-code-letter {
        text-transform: uppercase;
        border-color: #ccfbf1;
        color: #0d9488;
        box-shadow:
            0 10px 15px -3px rgb(204 251 241 / 50%),
            0 4px 6px -4px rgb(204 251 241 / 50%);
    }
    .otp-input:focus {
        border-color: #14b8a6;
        box-shadow: 0 0 0 4px rgb(20 184 166 / 10%);
        outline: none;
    }
    .landing-code-separator {
        text-align: center;
        color: #cbd5e1;
        font-size: 2.25rem;
        font-weight: 100;
    }
    #hasi-button {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        min-height: 48px;
        margin: 2rem auto 0;
        padding: 1rem 3rem;
        border-radius: 16px;
        background: #0d9488;
        color: #fff;
        font-size: 1.25rem;
        font-weight: 900;
        box-shadow: 0 20px 25px -5px rgb(13 148 136 / 30%);
        transition:
            opacity 0.3s,
            transform 0.3s,
            visibility 0.3s,
            background-color 0.2s;
    }
    #hasi-button:hover:enabled {
        background: #0f766e;
    }
    #hasi-button:active:enabled {
        transform: scale(0.95);
    }
    #hasi-button:disabled {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transform: translateY(1rem);
    }
    #error-message {
        margin-top: 1rem;
        font-size: 0.85rem;
        color: #b91c1c;
        text-align: center;
    }
    .landing-footer {
        padding: 1rem;
        text-align: center;
        color: #94a3b8;
        font-size: 0.75rem;
    }
    .landing-page :is(a, select, button):focus-visible {
        outline: 2px solid #0d9488;
        outline-offset: 3px;
    }
    @media (prefers-reduced-motion: reduce) {
        .otp-input,
        #hasi-button {
            transition: none;
        }
        #hasi-button:disabled,
        #hasi-button:active:enabled {
            transform: none;
        }
    }
    @media (min-width: 600px) {
        .landing-header {
            padding: 1rem 2rem;
        }
        .landing-admin {
            padding-inline: 0.75rem;
        }
        .landing-admin-label {
            display: inline;
        }
    }
</style>
