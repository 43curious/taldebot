---
import Layout from '../layouts/Layout.astro';
import { studentPath, type Language } from '../lib/i18n';
interface Props {
    lang: Language;
    title: string;
    message?: string;
}
const { lang, title, message } = Astro.props;
---

<Layout title={title} lang={lang}>
    <main class="mx-auto flex min-h-svh max-w-lg items-center p-5">
        <section class="w-full rounded-xl border border-slate-200 bg-white p-6">
            <h1 class="text-xl font-semibold text-slate-900">{title}</h1>
            <p class="mt-3 text-sm leading-relaxed text-slate-600">
                {message ||
                    (lang === 'en'
                        ? 'Ask your teacher for your personal survey link. The project code is a shared entry point; your personal link identifies your own record.'
                        : 'Eskatu irakasleari zure inkestaren esteka pertsonala. Proiektuaren kodea sarrera partekatua da; esteka pertsonalak zure erregistroa identifikatzen du.')}
            </p>
            <a
                class="mt-5 inline-flex min-h-11 items-center text-sm text-teal-700"
                href={studentPath(lang)}
            >
                {lang === 'en' ? 'Back home' : 'Hasierara bueltatu'}
            </a>
        </section>
    </main>
</Layout>
