---
import { t, type Language } from '../lib/i18n';
interface Props {
    lang: Language;
    returnHref?: string;
    returnLabel?: string;
    localeHref?: string;
}
const {
    lang,
    returnHref = '/admin/dashboard',
    returnLabel,
    localeHref = '/admin/survey-trial',
} = Astro.props;
const tr = t(lang);
const localeUrl = (language: Language) =>
    `${localeHref}${localeHref.includes('?') ? '&' : '?'}lang=${language}`;
---

<div class="mb-6 flex items-center justify-between gap-4">
    <a
        href={returnHref}
        class="inline-flex min-h-11 items-center text-sm text-slate-500 hover:text-teal-700"
    >
        ← {returnLabel ?? tr.surveyUi.admin}
    </a>
    <details class="survey-trial-info teacher-menu">
        <summary
            aria-label={tr.surveyUi.trialTitle}
            title={tr.surveyUi.trialTitle}
        >
            <svg
                aria-hidden="true"
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
            >
                <circle cx="12" cy="12" r="9" />
                <path stroke-linecap="round" d="M12 11v6" />
                <circle
                    cx="12"
                    cy="7"
                    r=".75"
                    fill="currentColor"
                    stroke="none"
                />
            </svg>
        </summary>
        <aside class="survey-trial-note" aria-label={tr.surveyUi.trialTitle}>
            <p class="text-sm font-semibold text-slate-900">
                {tr.surveyUi.trialTitle}
            </p>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">
                {tr.surveyUi.trialNote}
            </p>
            <nav
                class="teacher-tabs mt-3"
                aria-label={lang === 'en' ? 'Language' : 'Hizkuntza'}
            >
                <a
                    href={localeUrl('eu')}
                    aria-current={lang === 'eu' ? 'page' : undefined}
                >
                    Euskara
                </a>
                <a
                    href={localeUrl('en')}
                    aria-current={lang === 'en' ? 'page' : undefined}
                >
                    English
                </a>
            </nav>
        </aside>
    </details>
</div>
<script>
    const trialInfo =
        document.querySelector<HTMLDetailsElement>('.survey-trial-info');
    if (trialInfo) {
        document.addEventListener('click', (event) => {
            if (
                event.target instanceof Node &&
                !trialInfo.contains(event.target)
            )
                trialInfo.open = false;
        });
        trialInfo.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && trialInfo.open) {
                trialInfo.open = false;
                trialInfo.querySelector('summary')?.focus();
            }
        });
    }
</script>
