---
export const prerender = false;
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { db } from "../../../lib/db";
import { projects, teams } from "../../../../db/schema";
import { eq, and } from "drizzle-orm";
import TeamCard from "../../../components/TeamCard.astro";

const pid = Number(Astro.params.projectId);
const selectedVersion = Astro.url.searchParams.get("version") === "v1" ? "v1" : "v2";
if (!Number.isInteger(pid) || pid < 1) return Astro.redirect("/admin/dashboard");
const project = await db.query.projects.findFirst({ where: eq(projects.id, pid) });
if (!project) return Astro.redirect("/admin/dashboard");
const projectTeams = await db.query.teams.findMany({
    where: and(eq(teams.projectId, pid), eq(teams.algorithmVersion, selectedVersion)),
    orderBy: (teams, { asc }) => [asc(teams.teamNumber)],
});
const generateUrl = `/api/admin/generate-teams?projectId=${pid}&version=${selectedVersion}`;
const generationError = Astro.url.searchParams.get("error") === "no-students";
---

<AdminLayout title={`Taldeak: ${project.name}`}>
    <section class="teacher-page" aria-labelledby="teams-heading">
        <a href={`/admin/monitor/${pid}`} class="mb-4 inline-flex min-h-11 items-center text-sm text-slate-500 hover:text-teal-700 print:hidden">← Inkestaren jarraipena</a>
        <header class="mb-6 flex flex-wrap items-start justify-between gap-4">
            <div><h1 id="teams-heading">{project.name}</h1><p class="mt-2 text-sm text-slate-500">{projectTeams.length ? `${projectTeams.length} talde · ${projectTeams.reduce((count, team) => count + team.memberIds.length, 0)} ikasle` : "Taldeen esleipena"}</p></div>
            {projectTeams.length > 0 && <div class="teacher-toolbar print:hidden">
                <a href={`/api/admin/export-teams-txt?projectId=${pid}&version=${selectedVersion}`} class="teacher-button">Zerrenda deskargatu</a>
                <button type="button" onclick="window.print()" class="teacher-button">Inprimatu</button>
            </div>}
        </header>
        <details class="mb-6 print:hidden">
            <summary class="flex cursor-pointer items-center gap-2 text-sm text-slate-500">Taldeen aukerak <span aria-hidden="true">⌄</span></summary>
            <div class="teacher-panel mt-2 flex flex-wrap items-end gap-4 p-4">
                <form method="GET" class="flex flex-wrap items-end gap-3"><label class="teacher-label">Esleipen-eredua<select name="version"><option value="v2" selected={selectedVersion === "v2"}>Egungo eredua</option><option value="v1" selected={selectedVersion === "v1"}>Aurreko eredua</option></select></label><button class="teacher-button">Ikusi</button></form>
                {projectTeams.length > 0 && <>
                    <a href={`/api/admin/export-data?projectId=${pid}&version=${selectedVersion}`} class="teacher-button">Excel deskargatu</a>
                    <form action={generateUrl} method="POST" data-regenerate><button class="teacher-button">Taldeak berriro sortu</button></form>
                </>}
            </div>
        </details>
        {generationError && <p role="alert" class="mb-4 text-sm text-amber-700">Gehitu ikasleak proiektuan taldeak sortu aurretik.</p>}
        <div class="grid grid-cols-1 items-start gap-4 md:grid-cols-2 xl:grid-cols-3 print:grid-cols-2">
            {projectTeams.map(team => <TeamCard teamNumber={team.teamNumber} memberIds={team.memberIds} justification={team.justification} />)}
            {projectTeams.length === 0 && <div class="teacher-panel col-span-full p-10 text-center">
                <h2 class="text-base text-slate-800">Ez dago talderik sortuta oraindik.</h2>
                <p class="mx-auto mt-2 max-w-md text-sm leading-relaxed text-slate-500">Sortu taldeak ikasleen gaitasunak eta lan-hobespenak erabiliz. Erantzun gabeko ikasleek batez besteko profila erabiliko dute.</p>
                <form action={generateUrl} method="POST" class="mt-5"><button class="teacher-button teacher-button-primary">Taldeak sortu</button></form>
            </div>}
        </div>
    </section>
</AdminLayout>
<script>
    document.querySelector<HTMLFormElement>("[data-regenerate]")?.addEventListener("submit", event => {
        if (!confirm("Taldeak berriro sortu? Eredu honetako egungo esleipena ordeztuko da.")) event.preventDefault();
    });
    document.querySelectorAll<HTMLFormElement>('form[action*="generate-teams"]').forEach(form => {
        form.addEventListener("submit", event => {
            if (event.defaultPrevented) return;
            const button = form.querySelector<HTMLButtonElement>("button");
            if (button) { button.disabled = true; button.textContent = "Taldeak sortzen…"; }
        });
    });
</script>
<style is:global>
    @media print {
        #admin-sidebar, #mobile-menu-button, #sidebar-backdrop { display: none !important; }
        #admin-content { padding-left: 0 !important; }
        .teacher-page .teacher-panel { break-inside: avoid; }
    }
</style>
