---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { db } from '../../../lib/db';
import {
    projects,
    teams,
    students,
    responses,
    teamDrafts,
    confirmedAssignments,
} from '../../../../db/schema';
import { eq, and } from 'drizzle-orm';
import TeamCard from '../../../components/TeamCard.astro';

import { formationMethodLabel } from '../../../lib/formationMethods';
import { isArchivedProject } from '../../../lib/projectLifecycle';
import { formationInputs } from '../../../lib/formation';
import { scoredSkills } from '../../../lib/skills';
import { teamMembers } from '../../../lib/projectData';

const pid = Number(Astro.params.projectId);
const selectedVersion =
    Astro.url.searchParams.get('version') === 'v1' ? 'v1' : 'v2';
if (!Number.isInteger(pid) || pid < 1)
    return Astro.redirect('/admin/dashboard');
const project = await db.query.projects.findFirst({
    where: eq(projects.id, pid),
});
if (!project) return Astro.redirect('/admin/dashboard');
const projectTeamsPromise = db.query.teams
    .findMany({
        where: and(
            eq(teams.projectId, pid),
            eq(teams.algorithmVersion, selectedVersion),
        ),
        orderBy: (teams, { asc }) => [asc(teams.teamNumber)],
    })
    .execute();
const archived = isArchivedProject(project);
let inputError = '';
const [
    projectTeams,
    participants,
    records,
    currentDraft,
    confirmed,
    inputState,
] = await Promise.all([
    projectTeamsPromise,
    db.query.students.findMany({
        where: eq(students.projectId, pid),
        orderBy: (row, { asc }) => [asc(row.id)],
    }),
    db.query.responses.findMany({ where: eq(responses.projectId, pid) }),
    projectTeamsPromise.then((rows) =>
        rows[0]?.draftId
            ? db.query.teamDrafts.findFirst({
                  where: eq(teamDrafts.id, rows[0].draftId),
              })
            : undefined,
    ),
    db.query.confirmedAssignments.findFirst({
        where: eq(confirmedAssignments.projectId, pid),
        orderBy: (row, { desc }) => [desc(row.revision)],
    }),
    archived
        ? undefined
        : formationInputs(db, Astro.locals.teacherAccess, pid).catch(
              (error) => {
                  inputError =
                      error instanceof Error
                          ? error.message
                          : 'Ezin izan dira sarrerak kargatu.';
                  return undefined;
              },
          ),
]);
const members = teamMembers(participants, records);
const cards = projectTeams.map((team) => ({
    ...team,
    membersWithSkills: team.memberIds
        .map((id) => members.get(id))
        .filter((member): member is NonNullable<typeof member> =>
            Boolean(member),
        )
        .sort((a, b) => a.id - b.id),
}));
const currentDraftId = projectTeams[0]?.draftId ?? null;
const snapshot = inputState?.snapshot;
const inputs = snapshot?.inputs.filter((input) => !input.excluded) ?? [];
const snapshotMembers = new Map(
    currentDraft?.inputSnapshot?.inputs.map((input) => [
        input.participantId,
        input,
    ]) ?? [],
);
for (const member of members.values()) {
    const input = snapshotMembers.get(member.id);
    if (input)
        member.topSkills = scoredSkills(input.assessment)
            .filter(
                (skill) =>
                    skill.category !== 'skillsSoft' && skill.val !== undefined,
            )
            .sort((a, b) => (b.val ?? 0) - (a.val ?? 0))
            .slice(0, 3);
}
const adopted = Boolean(
    confirmed && currentDraft && confirmed.draftId === currentDraft.id,
);
const mandatoryPairs =
    snapshot?.restrictions.map((rule) => [rule.student1Id, rule.student2Id]) ??
    [];
const generateUrl = `/api/admin/generate-teams?projectId=${pid}&version=${selectedVersion}`;
const recordedTowns =
    currentDraft?.inputSnapshot?.method === 'location'
        ? new Map(
              currentDraft.inputSnapshot.inputs.map((input) => [
                  input.participantId,
                  input.location?.source === 'teacher'
                      ? input.location.town
                      : null,
              ]),
          )
        : undefined;
const knownLocations = inputs.filter(
    (input) => input.location?.source === 'teacher' && input.location.town,
).length;
const defaultCount =
    project.numTeams ||
    Math.max(1, Math.round(inputs.length / (project.targetTeamSize || 4)));
const generationError = Astro.url.searchParams.get('error') === 'no-students';
---

<AdminLayout title={`Taldeak: ${project.name}`}>
    <section
        class="teacher-page"
        data-project-id={pid}
        data-draft-id={currentDraftId}
        data-restrictions={JSON.stringify(mandatoryPairs)}
        data-version={selectedVersion}
        aria-labelledby="teams-heading"
    >
        <a
            href={`/admin/monitor/${pid}`}
            class="mb-4 inline-flex min-h-11 items-center text-sm text-slate-500 hover:text-teal-700 print:hidden"
        >
            ← Proiektuaren jarraipena
        </a>
        <header class="mb-6 flex flex-wrap items-start justify-between gap-4">
            <div>
                <h1 id="teams-heading">{project.name}</h1>
                {project.audienceSnapshot && (
                    <p class="mt-2 text-xs text-slate-500">
                        {project.audienceSnapshot.className} ·{' '}
                        {project.audienceSnapshot.moduleName} ·{' '}
                        {project.audienceSnapshot.groupName} · Jarduera sortzean
                        hautatutako kideak
                    </p>
                )}
                <p class="mt-2 text-sm text-slate-500">
                    {projectTeams.length
                        ? `${projectTeams.length} talde · ${projectTeams.reduce((count, team) => count + team.memberIds.length, 0)} ikasle`
                        : 'Taldeen esleipena'}{' '}
                    ·{' '}
                    {archived
                        ? 'Artxibatuta'
                        : adopted
                          ? 'Berretsitako esleipena'
                          : 'Zirriborroa'}{' '}
                    {currentDraft &&
                        `· ${formationMethodLabel(currentDraft.inputSnapshot)}`}
                </p>
            </div>
            {projectTeams.length > 0 && (
                <div class="teacher-toolbar print:hidden">
                    <a
                        href={`/api/admin/export-teams-txt?projectId=${pid}&version=${selectedVersion}`}
                        class="teacher-button"
                    >
                        Zerrenda deskargatu
                    </a>
                    <button
                        type="button"
                        onclick="window.print()"
                        class="teacher-button"
                    >
                        Inprimatu
                    </button>
                </div>
            )}
        </header>
        <p
            id="team-feedback"
            role="status"
            class="mb-4 text-sm text-slate-600"
        ></p>
        {currentDraft && !archived && (
            <div class="teacher-toolbar mb-5">
                <button
                    type="button"
                    id="confirm-assignment"
                    disabled={adopted || !currentDraft.inputSnapshot}
                    class="teacher-button teacher-button-primary"
                >
                    {adopted ? 'Esleipena berretsita' : 'Esleipena berretsi'}
                </button>
                <p class="text-xs text-slate-500">
                    Zirriborroek ez dute parekatze-historia osatzen. Berrespenak
                    sarrerak eta kideen datatutako esleipena gordetzen ditu.
                    {currentDraft.inputSnapshot?.method === 'location' &&
                        ' Txarteletako kokapenak zirriborroa sortzean jasotakoak dira.'}
                </p>
            </div>
        )}
        {currentDraft?.source === 'legacy-draft' && (
            <p class="mb-4 text-xs text-amber-700">
                Aurretiko zirriborroa da; ez dago berretsitzat hartuta. Berriro
                sortu edo eskuz egokitu sarrerak erregistratzeko.
            </p>
        )}
        <details class="mb-6 print:hidden">
            <summary class="flex cursor-pointer items-center gap-2 text-sm text-slate-500">
                Taldeen aukerak <span aria-hidden="true">⌄</span>
            </summary>
            <div class="teacher-panel mt-2 flex flex-wrap items-end gap-4 p-4">
                <form method="GET" class="flex flex-wrap items-end gap-3">
                    <label class="teacher-label">
                        Esleipen-eredua
                        <select name="version">
                            <option
                                value="v2"
                                selected={selectedVersion === 'v2'}
                            >
                                Egungo eredua
                            </option>
                            <option
                                value="v1"
                                selected={selectedVersion === 'v1'}
                            >
                                Aurreko eredua
                            </option>
                        </select>
                    </label>
                    <button class="teacher-button">Ikusi</button>
                </form>
                {projectTeams.length > 0 && (
                    <>
                        <a
                            href={`/api/admin/export-data?projectId=${pid}&version=${selectedVersion}`}
                            class="teacher-button"
                        >
                            Excel deskargatu
                        </a>
                    </>
                )}
            </div>
        </details>
        {inputError && (
            <p role="alert" class="mb-4 text-sm text-amber-700">
                {inputError}
            </p>
        )}
        {!archived && snapshot && (
            <section
                class="teacher-panel mb-5 p-4 print:hidden"
                aria-labelledby="formation-heading"
            >
                <h2 id="formation-heading" class="text-base">
                    Taldeak osatu
                </h2>
                <p class="mt-2 text-xs text-slate-500">
                    {inputs.length} ikasle aktibo ·{' '}
                    {snapshot.inputs.filter((input) => input.excluded).length}{' '}
                    kanpoan · {mandatoryPairs.length} derrigorrezko murrizketa.
                    Ausaz edo eskuz osatzeko ez da inkestarik behar.
                </p>
                <form
                    id="formation-form"
                    action={generateUrl}
                    method="POST"
                    class="mt-4 space-y-4"
                >
                    <div class="teacher-toolbar">
                        <label class="teacher-label">
                            Metodoa
                            <select name="method">
                                <option
                                    value="random"
                                    selected={
                                        currentDraft?.inputSnapshot?.method ===
                                            'random' || !currentDraft
                                    }
                                >
                                    Ausaz
                                </option>
                                <option
                                    value="manual"
                                    selected={
                                        currentDraft?.inputSnapshot?.method ===
                                        'manual'
                                    }
                                >
                                    Irakasleak eskuz
                                </option>
                                <option
                                    value="survey"
                                    selected={
                                        currentDraft &&
                                        (!currentDraft.inputSnapshot?.method ||
                                            currentDraft.inputSnapshot
                                                .method === 'survey')
                                    }
                                >
                                    Gaitasunak eta hobespenak
                                </option>
                                <option
                                    value="location"
                                    selected={
                                        currentDraft?.inputSnapshot?.method ===
                                        'location'
                                    }
                                >
                                    Ikasturteko herriaren arabera
                                </option>
                            </select>
                        </label>
                        <label class="teacher-label">
                            Talde kopurua
                            <input
                                name="numTeams"
                                type="number"
                                min="1"
                                max={Math.max(1, inputs.length)}
                                value={defaultCount}
                                required
                            />
                        </label>
                        <label class="teacher-label" data-survey-controls>
                            Jarraitutasuna / berritasuna
                            <select name="historyMode">
                                <option
                                    value="balanced"
                                    selected={
                                        project.historyMode === 'balanced'
                                    }
                                >
                                    Oreka
                                </option>
                                <option
                                    value="variety"
                                    selected={project.historyMode === 'variety'}
                                >
                                    Kide berriak lehenetsi
                                </option>
                                <option
                                    value="familiar"
                                    selected={
                                        project.historyMode === 'familiar'
                                    }
                                >
                                    Kide ezagunak lehenetsi
                                </option>
                            </select>
                        </label>
                    </div>
                    <p id="method-help" class="text-xs text-slate-500"></p>
                    <div data-location-controls hidden>
                        <p class="text-xs text-slate-500">
                            {knownLocations} kokapen baieztatu ·{' '}
                            {inputs.length - knownLocations} kokapen ezezagun
                            edo baieztatu gabe. Ezezagunak geratzen diren
                            tokietan banatuko dira.
                        </p>
                        <details class="mt-3">
                            <summary class="cursor-pointer text-xs text-slate-500">
                                Kokapenak berrikusi / editatu
                            </summary>
                            <ul class="mt-2 divide-y divide-slate-100">
                                {inputs.map((input) => (
                                    <li class="flex flex-wrap justify-between gap-2 py-2 text-sm">
                                        <a
                                            class="underline"
                                            href={`/admin/students/${input.studentId}#student-location`}
                                        >
                                            {input.name}
                                        </a>
                                        <span class="text-xs text-slate-500">
                                            {input.location?.source ===
                                                'teacher' && input.location.town
                                                ? input.location.town
                                                : input.location?.town
                                                  ? `${input.location.town} · Baieztatu gabe`
                                                  : 'Ezezaguna'}
                                        </span>
                                    </li>
                                ))}
                            </ul>
                        </details>
                    </div>
                    <div data-manual-controls hidden>
                        <div class="grid gap-3 sm:grid-cols-2">
                            {inputs.map((input) => (
                                <label class="teacher-label">
                                    {input.name}
                                    <select
                                        data-manual-student={input.studentId}
                                        aria-label={`${input.name}: taldea`}
                                    >
                                        <option value="">Taldea hautatu</option>
                                        {Array.from(
                                            { length: defaultCount },
                                            (_, i) => (
                                                <option value={i + 1}>
                                                    {i + 1}. taldea
                                                </option>
                                            ),
                                        )}
                                    </select>
                                </label>
                            ))}
                        </div>
                        <p
                            id="manual-feedback"
                            role="status"
                            class="mt-3 text-xs text-slate-500"
                        ></p>
                    </div>
                    <button
                        class="teacher-button teacher-button-primary"
                        disabled={!inputs.length}
                    >
                        Zirriborroa sortu
                    </button>
                </form>
            </section>
        )}
        {!archived && (
            <details class="teacher-panel mb-5 print:hidden">
                <summary class="cursor-pointer p-4 text-sm text-slate-600">
                    Sarrerak eta derrigorrezko murrizketak berrikusi
                </summary>
                <div class="border-t border-slate-100 p-4">
                    <p class="text-xs leading-relaxed text-slate-500">
                        Autoebaluazio ezezagunek 5eko algoritmo-balioa
                        erabiltzen dute soilik; ez da ikaslearen historian
                        gordetzen. Proiektu berrian hobespenak berrikusteko
                        eskatu. Aurreko historia berretsitako esleipenetatik
                        dator.
                    </p>
                    <ul class="my-4 divide-y divide-slate-100">
                        {inputs.map((input) => (
                            <li class="flex flex-wrap justify-between gap-2 py-2 text-xs">
                                <span class="font-medium text-slate-700">
                                    {input.name}
                                </span>
                                <span class="text-slate-500">
                                    {input.assessmentDate
                                        ? new Date(
                                              input.assessmentDate,
                                          ).toLocaleDateString('eu-ES')
                                        : 'Autoebaluazio-data ezezaguna'}{' '}
                                    ·{' '}
                                    {input.assessmentSource ||
                                        'Erantzunik gabe'}{' '}
                                    ·{' '}
                                    {input.needsReview
                                        ? 'Berrikuspena eskatu'
                                        : 'Testuinguru honetan berretsita'}
                                </span>
                            </li>
                        ))}
                    </ul>
                    <p class="mb-4 text-xs text-red-700">
                        {mandatoryPairs.length} derrigorrezko murrizketa.
                        Berrikuspen-data igarotzeak ez ditu kentzen.
                    </p>
                    <ul class="mb-4 space-y-2">
                        {snapshot?.restrictions.map((rule) => (
                            <li class="text-xs text-red-700">
                                <a href={`/admin/students/${rule.student1Id}`}>
                                    {
                                        snapshot.inputs.find(
                                            (input) =>
                                                input.studentId ===
                                                rule.student1Id,
                                        )?.name
                                    }
                                </a>{' '}
                                ·{' '}
                                <a href={`/admin/students/${rule.student2Id}`}>
                                    {
                                        snapshot.inputs.find(
                                            (input) =>
                                                input.studentId ===
                                                rule.student2Id,
                                        )?.name
                                    }
                                </a>{' '}
                                · Derrigorrez bereizi · Berrikuspena:{' '}
                                {rule.reviewAt}
                            </li>
                        ))}
                    </ul>
                </div>
            </details>
        )}
        {currentDraft && !archived && (
            <details class="teacher-panel mb-5 print:hidden">
                <summary class="cursor-pointer p-4 text-sm text-slate-600">
                    Kideak mugitu / trukatu
                </summary>
                <form id="adjust-draft" class="border-t border-slate-100 p-4">
                    <p class="mb-4 text-xs text-slate-500">
                        Aldaketak zirriborro berri batean gordetzen dira.
                        Berretsitako aurreko esleipena ez da ordezten berretsi
                        arte.
                    </p>
                    <div class="grid gap-3 sm:grid-cols-2">
                        {currentDraft.allocation.flatMap((team) =>
                            team.studentIds.map((id) => (
                                <label class="teacher-label">
                                    {participants.find(
                                        (participant) =>
                                            participant.studentRecordId === id,
                                    )?.name || 'Ikaslea'}
                                    <select data-student-record-id={id}>
                                        {currentDraft.allocation.map(
                                            (option) => (
                                                <option
                                                    value={option.teamNumber}
                                                    selected={
                                                        option.teamNumber ===
                                                        team.teamNumber
                                                    }
                                                >
                                                    {option.teamNumber}. taldea
                                                </option>
                                            ),
                                        )}
                                    </select>
                                </label>
                            )),
                        )}
                    </div>
                    <p
                        id="allocation-feedback"
                        class="mt-4 text-xs text-slate-500"
                        role="status"
                    ></p>
                    <button class="teacher-button mt-4" type="submit">
                        Zirriborroko aldaketak gorde
                    </button>
                </form>
            </details>
        )}
        {confirmed && (
            <details class="mb-5">
                <summary class="cursor-pointer text-xs text-slate-500">
                    Azken berrespena ·{' '}
                    {new Date(confirmed.confirmedAt).toLocaleDateString(
                        'eu-ES',
                    )}{' '}
                    · {confirmed.revision}. berrikuspena
                </summary>
                <p class="mt-2 text-xs text-slate-500">
                    Sarrerak:{' '}
                    {confirmed.inputSnapshot?.capturedAt
                        ? new Date(
                              confirmed.inputSnapshot.capturedAt,
                          ).toLocaleString('eu-ES')
                        : 'Aurretiko datuak'}{' '}
                    · {formationMethodLabel(confirmed.inputSnapshot)}{' '}
                    {confirmed.inputSnapshot?.method &&
                    confirmed.inputSnapshot.method !== 'survey'
                        ? ''
                        : confirmed.inputSnapshot?.historyMode === 'variety'
                          ? 'Kide berriak'
                          : confirmed.inputSnapshot?.historyMode === 'familiar'
                            ? 'Kide ezagunak'
                            : 'Oreka'}
                </p>
                {confirmed.inputSnapshot?.method === 'location' && (
                    <details class="mt-3">
                        <summary class="cursor-pointer text-xs text-slate-500">
                            Berrespenean gordetako kokapenak
                        </summary>
                        <p class="mt-2 text-xs text-slate-500">
                            Ikasturteko herri bera lehenetsi zen. Herri
                            ezezagunek ez zuten kokapen-irizpiderik eman.
                        </p>
                        <ul class="mt-2 space-y-2">
                            {confirmed.inputSnapshot.inputs
                                .filter((input) => !input.excluded)
                                .map((input) => (
                                    <li class="text-xs text-slate-500">
                                        {input.name} ·{' '}
                                        {input.location?.source === 'teacher' &&
                                        input.location.town
                                            ? input.location.town
                                            : 'Kokapen ezezaguna'}{' '}
                                        ·{' '}
                                        {input.location?.updatedAt
                                            ? new Date(
                                                  input.location.updatedAt,
                                              ).toLocaleDateString('eu-ES')
                                            : 'Baieztapenik gabe'}
                                    </li>
                                ))}
                        </ul>
                    </details>
                )}
            </details>
        )}
        {generationError && (
            <p role="alert" class="mb-4 text-sm text-amber-700">
                Gehitu ikasleak proiektuan taldeak sortu aurretik.
            </p>
        )}
        <div class="grid grid-cols-1 items-start gap-4 md:grid-cols-2 xl:grid-cols-3 print:grid-cols-2">
            {cards.map((team) => (
                <TeamCard
                    teamNumber={team.teamNumber}
                    membersWithSkills={team.membersWithSkills}
                    justification={team.justification}
                    towns={recordedTowns}
                />
            ))}
            {projectTeams.length === 0 && !archived && (
                <div class="teacher-panel col-span-full p-10 text-center">
                    <h2 class="text-base text-slate-800">
                        Ez dago talderik sortuta oraindik.
                    </h2>
                    <p class="mx-auto mt-2 max-w-md text-sm leading-relaxed text-slate-500">
                        Hautatu goiko metodoa: ausaz, eskuz edo gaitasunak eta
                        hobespenak erabiliz. Berretsi esleipena taldeak
                        historian gordetzeko.
                    </p>
                </div>
            )}
        </div>
    </section>
</AdminLayout>
<script>
    const page = document.querySelector<HTMLElement>('[data-project-id]')!;
    const feedback = document.querySelector<HTMLElement>('#team-feedback')!;
    const projectId = Number(page.dataset.projectId);
    const draftId = Number(page.dataset.draftId);
    const rules: number[][] = JSON.parse(page.dataset.restrictions || '[]');
    async function requestUpdate(payload: object) {
        const response = await fetch('/api/admin/team-draft', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ...payload, projectId, draftId }),
        });
        const result = await response.json();
        if (!response.ok)
            throw new Error(result.error || 'Ezin izan da aldaketa gorde.');
    }
    document
        .querySelector<HTMLButtonElement>('#confirm-assignment')
        ?.addEventListener('click', async (event) => {
            if (
                !confirm(
                    'Esleipena berretsi? Aurreko esleipena historian gordeko da, eta kideen egungo esleipena eguneratuko da.',
                )
            )
                return;
            const button = event.currentTarget as HTMLButtonElement;
            button.disabled = true;
            try {
                await requestUpdate({ action: 'confirm' });
                window.location.reload();
            } catch (error) {
                feedback.textContent =
                    error instanceof Error
                        ? error.message
                        : 'Ezin izan da berretsi.';
                button.disabled = false;
            }
        });
    const adjust = document.querySelector<HTMLFormElement>('#adjust-draft');
    const controls = [
        ...(adjust?.querySelectorAll<HTMLSelectElement>(
            '[data-student-record-id]',
        ) || []),
    ];
    function allocation() {
        const teams = new Map<number, number[]>();
        for (const option of controls[0]?.options || [])
            teams.set(Number(option.value), []);
        for (const control of controls) {
            const group = Number(control.value);
            const ids = teams.get(group) || [];
            ids.push(Number(control.dataset.studentRecordId));
            teams.set(group, ids);
        }
        return [...teams]
            .sort((a, b) => a[0] - b[0])
            .map(([teamNumber, studentIds]) => ({
                teamNumber,
                studentIds,
                justification: 'Irakasleak eskuz egokitua',
            }));
    }
    function validate() {
        const groups = allocation();
        const blocked = rules.some(([first, second]) =>
            groups.some(
                (group) =>
                    group.studentIds.includes(first) &&
                    group.studentIds.includes(second),
            ),
        );
        const status = document.querySelector<HTMLElement>(
            '#allocation-feedback',
        );
        if (status) {
            status.textContent = blocked
                ? 'Derrigorrezko murrizketa hausten da. Aldatu hautapena.'
                : groups
                      .map(
                          (group) =>
                              `${group.teamNumber}. taldea: ${group.studentIds.length} kide`,
                      )
                      .join(' · ');
            status.classList.toggle('text-red-700', blocked);
        }
        const button = adjust?.querySelector<HTMLButtonElement>(
            'button[type="submit"]',
        );
        if (button) button.disabled = blocked;
        return !blocked;
    }
    controls.forEach((control) =>
        control.addEventListener('change', () => {
            validate();
            const confirm = document.querySelector<HTMLButtonElement>(
                '#confirm-assignment',
            );
            if (confirm) confirm.disabled = true;
        }),
    );
    adjust?.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!validate()) return;
        try {
            await requestUpdate({ action: 'adjust', allocation: allocation() });
            window.location.reload();
        } catch (error) {
            feedback.textContent =
                error instanceof Error ? error.message : 'Ezin izan da gorde.';
        }
    });
    validate();
    const formation =
        document.querySelector<HTMLFormElement>('#formation-form');
    if (formation) {
        const method =
            formation.querySelector<HTMLSelectElement>('[name="method"]')!;
        const count =
            formation.querySelector<HTMLInputElement>('[name="numTeams"]')!;
        const manualControls = [
            ...formation.querySelectorAll<HTMLSelectElement>(
                '[data-manual-student]',
            ),
        ];
        function updateMethod() {
            const manual = method.value === 'manual';
            formation!.querySelector<HTMLElement>(
                '[data-manual-controls]',
            )!.hidden = !manual;
            formation!.querySelector<HTMLElement>(
                '[data-survey-controls]',
            )!.hidden = method.value !== 'survey';
            formation!.querySelector<HTMLElement>(
                '[data-location-controls]',
            )!.hidden = method.value !== 'location';
            formation!.querySelector<HTMLSelectElement>(
                '[name="historyMode"]',
            )!.disabled = method.value !== 'survey';
            manualControls.forEach((control) => {
                control.required = manual;
                control.disabled = !manual;
            });
            document.querySelector<HTMLElement>('#method-help')!.textContent =
                manual
                    ? 'Hautatu ikasle bakoitzaren taldea. Tamainak orekatu eta derrigorrezko murrizketak bete behar dira.'
                    : method.value === 'random'
                      ? 'Ausazko banaketa: tamainak, bertaratzea eta derrigorrezko murrizketak soilik. Gaitasunek, hobespenek eta aurreko taldeek ez dute eraginik.'
                      : method.value === 'location'
                        ? 'Ikasturtean herri berean bizi diren kideak elkartzea lehenesten da, tamainak eta derrigorrezko murrizketak betez. Ez da distantziarik kalkulatzen; gaitasunak, hobespenak eta aurreko taldeak ez dira erabiltzen.'
                        : 'Autoebaluazioak, hobespenak eta berretsitako esleipenen historia erabiltzen dira. Erantzun ezezagunetarako algoritmoak 5eko ordezko balioa erabiltzen du.';
        }
        function manualCounts() {
            const counts = new Map<number, number>();
            manualControls.forEach((control) => {
                if (control.value)
                    counts.set(
                        Number(control.value),
                        (counts.get(Number(control.value)) || 0) + 1,
                    );
            });
            const min = Math.floor(manualControls.length / Number(count.value)),
                max = Math.ceil(manualControls.length / Number(count.value));
            document.querySelector<HTMLElement>(
                '#manual-feedback',
            )!.textContent =
                `Taldeko ${min === max ? min : `${min}–${max}`} kide · ` +
                Array.from(
                    { length: Number(count.value) },
                    (_, i) => `${i + 1}. taldea: ${counts.get(i + 1) || 0}`,
                ).join(' · ');
        }
        count.addEventListener('change', () => {
            if (!count.checkValidity()) return;
            manualControls.forEach((control) => {
                const previous = control.value;
                control.replaceChildren(
                    new Option('Taldea hautatu', ''),
                    ...Array.from(
                        { length: Number(count.value) },
                        (_, i) => new Option(`${i + 1}. taldea`, String(i + 1)),
                    ),
                );
                if (Number(previous) <= Number(count.value))
                    control.value = previous;
            });
            manualCounts();
        });
        manualControls.forEach((control) =>
            control.addEventListener('change', manualCounts),
        );
        method.addEventListener('change', updateMethod);
        updateMethod();
        manualCounts();
    }
    document
        .querySelectorAll<HTMLFormElement>('form[action*="generate-teams"]')
        .forEach((form) => {
            form.addEventListener('submit', async (event) => {
                event.preventDefault();
                if (
                    draftId &&
                    !confirm(
                        'Zirriborro hau ordeztu? Berretsitako esleipenen historia ez da aldatuko.',
                    )
                )
                    return;
                const button = form.querySelector<HTMLButtonElement>('button')!;
                button.disabled = true;
                try {
                    const method =
                        form.querySelector<HTMLSelectElement>(
                            '[name="method"]',
                        )!.value;
                    if (method === 'manual') {
                        const count = Number(
                            form.querySelector<HTMLInputElement>(
                                '[name="numTeams"]',
                            )!.value,
                        );
                        const allocation = Array.from(
                            { length: count },
                            (_, index) => ({
                                teamNumber: index + 1,
                                studentIds: [] as number[],
                                justification: '',
                            }),
                        );
                        for (const control of form.querySelectorAll<HTMLSelectElement>(
                            '[data-manual-student]',
                        )) {
                            const group = Number(control.value);
                            if (!group || !allocation[group - 1])
                                throw new Error(
                                    'Hautatu ikasle guztien taldea.',
                                );
                            allocation[group - 1].studentIds.push(
                                Number(control.dataset.manualStudent),
                            );
                        }
                        await requestUpdate({
                            action: 'manual',
                            version: page.dataset.version,
                            numTeams: count,
                            allocation,
                        });
                        window.location.reload();
                        return;
                    }
                    const response = await fetch(form.action, {
                        method: 'POST',
                        body: new FormData(form),
                    });
                    if (!response.ok) {
                        const result = await response.json();
                        throw new Error(
                            result.error || 'Ezin izan da zirriborroa sortu.',
                        );
                    }
                    window.location.assign(response.url);
                } catch (error) {
                    feedback.textContent =
                        error instanceof Error
                            ? error.message
                            : 'Ezin izan da zirriborroa sortu.';
                    button.disabled = false;
                }
            });
        });
</script>
<style is:global>
    @media print {
        #admin-sidebar,
        #mobile-menu-button,
        #sidebar-backdrop {
            display: none !important;
        }
        #admin-content {
            padding-left: 0 !important;
        }
        .teacher-page .teacher-panel {
            break-inside: avoid;
        }
    }
</style>
