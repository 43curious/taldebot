---
export const prerender = false;
import AdminLayout from "../../layouts/AdminLayout.astro";
import { db } from "../../lib/db";
import { loadDashboard } from "../../lib/projectData";

const adminUser = (await Astro.session?.get<string>('adminUser')) || "Admin";
const projectStats = await loadDashboard(db);
---

<AdminLayout title="Arbel nagusia">
    <section class="teacher-page" aria-labelledby="dashboard-heading">
        <header class="mb-8 flex flex-wrap items-end justify-between gap-4">
            <div>
                <h1 id="dashboard-heading">Arbel nagusia</h1>
                <p class="mt-2 text-sm font-medium text-slate-500">Kaixo, {adminUser}. Kudeatu zure proiektuak hemen.</p>
            </div>
            <a href="/admin/create-project" class="rounded-lg bg-teal-600 px-4 py-2.5 text-sm font-bold text-white transition-colors hover:bg-teal-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-600">
                + Proiektu berria
            </a>
        </header>

        <h2 class="mb-4 flex items-center gap-2 text-lg font-bold text-slate-900">
            Proiektuak <span class="rounded-full bg-teal-50 px-2 py-0.5 text-xs text-teal-700">{projectStats.length}</span>
        </h2>
        <div class="space-y-4">
            {projectStats.map((project) => (
                <article class="flex flex-col overflow-hidden rounded-xl border border-slate-200 bg-white xl:grid xl:grid-cols-[minmax(0,1fr)_14rem_11rem]">
                    <div class="min-w-0 p-5">
                        <div class="flex items-start justify-between gap-3">
                            <h3 class="min-w-0 text-lg font-semibold leading-snug text-slate-900">
                                <a href={`/admin/monitor/${project.id}`} class="break-words transition-colors hover:text-teal-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-600">{project.name}</a>
                            </h3>
                            <button type="button" class="delete-project-btn flex h-11 w-11 shrink-0 items-center justify-center rounded-lg text-slate-500 transition-colors hover:bg-red-50 hover:text-red-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600" data-project-id={project.id} data-project-name={project.name} aria-label={`Ezabatu ${project.name}`} title="Ezabatu proiektua">
                                <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
                                </svg>
                            </button>
                        </div>
                        {project.description && <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-slate-600">{project.description}</p>}
                        <div class="mt-3">
                            <div class="flex flex-wrap items-center gap-3 text-xs text-slate-500">
                                <span class:list={["rounded-full border px-2.5 py-1 font-semibold", project.status === "active" ? "border-teal-200 bg-teal-50 text-teal-700" : project.status === "completed" ? "border-slate-200 bg-slate-50 text-slate-600" : "border-amber-200 bg-amber-50 text-amber-700"]}>
                                    {project.status === "active" ? "Aktibo" : project.status === "completed" ? "Amaituta" : "Prestaketa"}
                                </span>
                                <span>Sortua: {project.createdAt ? new Date(project.createdAt).toLocaleDateString("eu-ES") : "Data ezezaguna"}</span>
                            </div>
                        </div>
                        {project.accessCode && (
                            <div class="mt-4">
                                <button type="button" class="copy-code-btn inline-flex min-h-11 max-w-full flex-wrap items-center gap-x-3 gap-y-1 rounded-lg border border-teal-200 bg-teal-50 px-3 py-2 text-sm text-teal-800 transition-colors hover:border-teal-300 hover:bg-teal-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-600 disabled:cursor-wait" data-access-code={project.accessCode} aria-label={`Kopiatu ${project.name} proiektuaren kodea: ${project.accessCode}`} title="Kopiatu kodea">
                                    <span class="text-xs font-medium">Kodea:</span>
                                    <span class="break-all font-mono font-bold tracking-wider">{project.accessCode}</span>
                                    <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                        <rect x="9" y="9" width="11" height="11" rx="2" />
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 9V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h4" />
                                    </svg>
                                    <span class="copy-feedback text-xs font-semibold" role="status" aria-live="polite" aria-atomic="true">Kopiatu</span>
                                </button>
                            </div>
                        )}
                    </div>
                    <div class="flex flex-col justify-center border-t border-slate-100 bg-slate-50/60 p-5 xl:border-l xl:border-t-0">
                        <div class="mb-3 flex items-end justify-between gap-2">
                            <span class="text-xs text-slate-500">Inkestaren egoera</span>
                            <strong class="text-lg font-medium text-teal-700">{project.percentage}%</strong>
                        </div>
                        <div role="progressbar" aria-label={`${project.name}: bete-maila`} aria-valuenow={project.percentage} aria-valuemin="0" aria-valuemax="100" class="h-1.5 overflow-hidden rounded-full bg-slate-200">
                            <div class="h-full rounded-full bg-teal-600" style={`width: ${project.percentage}%`}></div>
                        </div>
                        <p class="mt-2 text-xs text-slate-600">{project.totalStudents === 0 ? "Ez dago ikaslerik oraindik" : `${project.completedStudents} / ${project.totalStudents} ikaslek erantzun dute`}</p>
                    </div>
                    <div class="grid grid-cols-2 gap-2 border-t border-slate-100 p-4 xl:content-center xl:grid-cols-1 xl:border-l xl:border-t-0">
                        <a href={`/admin/monitor/${project.id}`} class="flex min-h-11 items-center justify-center rounded-lg bg-teal-600 px-3 py-2 text-center text-sm font-bold text-white transition-colors hover:bg-teal-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-600">Kudeatu</a>
                        <a href={`/admin/teams/${project.id}`} class="flex min-h-11 items-center justify-center rounded-lg border border-slate-200 bg-white px-3 py-2 text-center text-sm font-bold text-slate-700 transition-colors hover:bg-slate-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-600">Ikusi taldeak</a>
                    </div>
                </article>
            ))}
            {projectStats.length === 0 && <p class="col-span-full rounded-2xl border-2 border-dashed border-slate-200 bg-white p-10 text-center text-sm text-slate-500">Ez dago proiekturik oraindik. Sortu zure lehena hasteko!</p>}
        </div>
    </section>
</AdminLayout>

<script>
    document.querySelectorAll<HTMLButtonElement>(".copy-code-btn").forEach((button) => {
        const feedback = button.querySelector<HTMLElement>(".copy-feedback");
        const code = button.dataset.accessCode;
        if (!feedback || !code) return;
        let resetTimer: number | undefined;

        button.addEventListener("click", async () => {
            window.clearTimeout(resetTimer);
            button.disabled = true;
            feedback.textContent = "Kopiatzen…";
            try {
                await navigator.clipboard.writeText(code);
                feedback.textContent = "Kopiatuta!";
            } catch {
                feedback.textContent = "Ezin izan da kopiatu. Saiatu berriro.";
            } finally {
                button.disabled = false;
                resetTimer = window.setTimeout(() => {
                    feedback.textContent = "Kopiatu";
                }, 1500);
            }
        });
    });

    const deleteButtons = document.querySelectorAll(".delete-project-btn");

    deleteButtons.forEach((btn) => {
        btn.addEventListener("click", async () => {
            const projectId = btn.getAttribute("data-project-id");
            const projectName = btn.getAttribute("data-project-name");

            const message = `Seguru zaude "${projectName}" ezabatu nahi duzula? Bertako datu guztiak ezabatuko dira. Deskargatu datuak lehenago, behar badituzu.`;

            if (confirm(message)) {
                try {
                    const response = await fetch("/api/admin/delete-project", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                        },
                        body: JSON.stringify({
                            projectId: parseInt(projectId!),
                        }),
                    });

                    if (response.ok) {
                        window.location.reload();
                    } else {
                        alert("Errorea proiektua ezabatzerakoan.");
                    }
                } catch (error) {
                    console.error("Error:", error);
                    alert("Errorea proiektua ezabatzerakoan.");
                }
            }
        });
    });
</script>
