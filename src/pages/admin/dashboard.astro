---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import { db } from '../../lib/db';
import { loadDashboard } from '../../lib/projectData';
import { isMaster } from '../../lib/access';
import { isArchivedProject } from '../../lib/projectLifecycle';

const adminUser = (await Astro.session?.get<string>('adminUser')) || 'Admin';
const allStats = await loadDashboard(db, Astro.locals.teacherAccess);
const showArchived = Astro.url.searchParams.get('archived') === '1';
const projectStats = allStats.filter((project) =>
    showArchived ? isArchivedProject(project) : !isArchivedProject(project),
);
const feedback = new Map([
    ['archive', 'Proiektua artxibatu da. Historia mantendu da.'],
    [
        'restore',
        'Proiektua leheneratu da. Inkestarako esteka berriak sortu behar dira.',
    ],
    [
        'delete',
        'Proiektua ezabatu da. Ikasleen historia eta jatorria mantendu dira.',
    ],
]).get(Astro.url.searchParams.get('feedback') || '');
---

<AdminLayout title="Arbel nagusia">
    <section class="teacher-page" aria-labelledby="dashboard-heading">
        <header class="mb-8 flex flex-wrap items-end justify-between gap-4">
            <div>
                <h1 id="dashboard-heading">Arbel nagusia</h1>
                <p class="mt-2 text-sm font-medium text-slate-500">
                    Kaixo, {adminUser}. Kudeatu zure proiektuak hemen.
                </p>
            </div>
            <a
                href="/admin/create-project"
                class="rounded-lg bg-teal-600 px-4 py-2.5 text-sm font-bold text-white transition-colors hover:bg-teal-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-600"
            >
                + Proiektu berria
            </a>
        </header>

        <a
            href={
                showArchived
                    ? '/admin/dashboard'
                    : '/admin/dashboard?archived=1'
            }
            class="mb-4 inline-flex min-h-11 items-center text-xs text-slate-500"
        >
            {showArchived ? 'Aktiboak ikusi' : 'Artxibatutako proiektuak'}
        </a>
        <h2 class="mb-4 flex items-center gap-2 text-lg font-bold text-slate-900">
            Proiektuak{' '}
            <span class="rounded-full bg-teal-50 px-2 py-0.5 text-xs text-teal-700">
                {projectStats.length}
            </span>
        </h2>
        <div class="space-y-4">
            <p
                id="project-action-feedback"
                role="status"
                class="text-sm text-teal-700"
            >
                {feedback}
            </p>
            {projectStats.map((project) => (
                <article class="teacher-panel grid min-w-0 lg:grid-cols-[minmax(0,1fr)_14rem]">
                    <div class="project-card-main grid min-w-0 grid-cols-[minmax(0,1fr)_8rem] gap-4 p-4 sm:grid-cols-[minmax(0,1fr)_9rem] sm:gap-5 sm:p-5">
                        <div class="project-info min-w-0">
                            <h3 class="text-lg font-semibold leading-snug text-slate-900">
                                <a
                                    href={`/admin/monitor/${project.id}`}
                                    class="break-words hover:text-teal-700"
                                >
                                    {project.name}
                                </a>
                            </h3>
                            {project.description && (
                                <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-slate-600">
                                    {project.description}
                                </p>
                            )}
                            <div class="mt-3">
                                <div class="flex flex-wrap items-center gap-3 text-xs text-slate-500">
                                    <span
                                        class:list={[
                                            'rounded-full border px-2.5 py-1 font-semibold',
                                            project.status === 'active'
                                                ? 'border-teal-200 bg-teal-50 text-teal-700'
                                                : project.status === 'completed'
                                                  ? 'border-slate-200 bg-slate-50 text-slate-600'
                                                  : 'border-amber-200 bg-amber-50 text-amber-700',
                                        ]}
                                    >
                                        {project.status === 'active'
                                            ? 'Aktibo'
                                            : project.status === 'completed'
                                              ? 'Amaituta'
                                              : isArchivedProject(project)
                                                ? 'Artxibatuta'
                                                : 'Prestaketa'}
                                    </span>
                                    <span>
                                        Sortua:{' '}
                                        {project.createdAt
                                            ? new Date(
                                                  project.createdAt,
                                              ).toLocaleDateString('eu-ES')
                                            : 'Data ezezaguna'}
                                    </span>
                                </div>
                            </div>
                            {project.accessCode && (
                                <div class="mt-4 flex flex-wrap items-center gap-2 text-sm text-slate-600">
                                    <span class="text-xs">Kodea:</span>
                                    <span class="break-all font-mono font-semibold tracking-wider text-slate-800">
                                        {project.accessCode}
                                    </span>
                                    <button
                                        type="button"
                                        class="copy-code-btn inline-flex min-h-11 min-w-11 shrink-0 items-center justify-center rounded-lg text-slate-500 hover:bg-teal-50 hover:text-teal-700"
                                        data-access-code={project.accessCode}
                                        aria-label={`Kopiatu ${project.name} proiektuaren kodea: ${project.accessCode}`}
                                        title="Kopiatu kodea"
                                    >
                                        <span data-copy-icon aria-hidden="true">
                                            <svg
                                                aria-hidden="true"
                                                xmlns="http://www.w3.org/2000/svg"
                                                class="h-4 w-4"
                                                fill="none"
                                                viewBox="0 0 24 24"
                                                stroke="currentColor"
                                                stroke-width="1.5"
                                            >
                                                <rect
                                                    x="9"
                                                    y="9"
                                                    width="11"
                                                    height="11"
                                                    rx="2"
                                                />
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    d="M15 9V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h4"
                                                />
                                            </svg>
                                        </span>
                                        <span
                                            data-copy-check
                                            hidden
                                            aria-hidden="true"
                                        >
                                            <svg
                                                aria-hidden="true"
                                                xmlns="http://www.w3.org/2000/svg"
                                                class="h-4 w-4 text-teal-700"
                                                fill="none"
                                                viewBox="0 0 24 24"
                                                stroke="currentColor"
                                                stroke-width="2"
                                            >
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    d="m5 12 4 4L19 6"
                                                />
                                            </svg>
                                        </span>
                                        <span
                                            class="copy-feedback sr-only"
                                            role="status"
                                            aria-live="polite"
                                            aria-atomic="true"
                                        ></span>
                                    </button>
                                </div>
                            )}
                        </div>
                        <div class="project-controls flex min-w-0 flex-col items-end justify-between gap-4">
                            <details class="project-menu teacher-menu">
                                <summary
                                    aria-label={`${project.name}: proiektuaren aukerak`}
                                    title="Proiektuaren aukerak"
                                >
                                    <svg
                                        aria-hidden="true"
                                        xmlns="http://www.w3.org/2000/svg"
                                        class="h-5 w-5"
                                        fill="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <circle cx="5" cy="12" r="2" />
                                        <circle cx="12" cy="12" r="2" />
                                        <circle cx="19" cy="12" r="2" />
                                    </svg>
                                </summary>
                                <div class="teacher-menu-content">
                                    <button
                                        type="button"
                                        class="project-action-btn text-slate-700"
                                        data-action={
                                            showArchived ? 'restore' : 'archive'
                                        }
                                        data-project-id={project.id}
                                        data-project-name={project.name}
                                        aria-label={`${showArchived ? 'Leheneratu' : 'Artxibatu'} ${project.name}`}
                                    >
                                        {showArchived
                                            ? 'Leheneratu proiektua'
                                            : 'Artxibatu proiektua'}
                                    </button>
                                    {isMaster(Astro.locals.teacherAccess) && (
                                        <button
                                            type="button"
                                            class="project-action-btn text-red-700"
                                            data-action="delete"
                                            data-project-id={project.id}
                                            data-project-name={project.name}
                                            aria-label={`Ezabatu betiko ${project.name}`}
                                        >
                                            Ezabatu betiko
                                        </button>
                                    )}
                                </div>
                            </details>
                            <div class="grid w-full gap-2">
                                <a
                                    href={`/admin/monitor/${project.id}`}
                                    class="teacher-button teacher-button-primary text-center"
                                >
                                    Kudeatu
                                </a>
                                <a
                                    href={`/admin/teams/${project.id}`}
                                    class="teacher-button text-center"
                                >
                                    Ikusi taldeak
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="flex flex-col justify-center project-progress rounded-b-xl border-t border-slate-100 bg-slate-50/60 p-5 lg:rounded-b-none lg:rounded-r-xl lg:border-l lg:border-t-0">
                        <div class="mb-3 flex items-end justify-between gap-2">
                            <span class="text-xs text-slate-500">
                                Inkestaren egoera
                            </span>
                            <strong class="text-lg font-medium text-teal-700">
                                {project.percentage}%
                            </strong>
                        </div>
                        <div
                            role="progressbar"
                            aria-label={`${project.name}: bete-maila`}
                            aria-valuenow={project.percentage}
                            aria-valuemin="0"
                            aria-valuemax="100"
                            class="h-1.5 overflow-hidden rounded-full bg-slate-200"
                        >
                            <div
                                class="h-full rounded-full bg-teal-600"
                                style={`width: ${project.percentage}%`}
                            ></div>
                        </div>
                        <p class="mt-2 text-xs text-slate-600">
                            {project.totalStudents === 0
                                ? 'Ez dago ikaslerik oraindik'
                                : `${project.completedStudents} / ${project.totalStudents} ikaslek erantzun dute`}
                        </p>
                    </div>
                </article>
            ))}
            {projectStats.length === 0 && (
                <p class="col-span-full rounded-2xl border-2 border-dashed border-slate-200 bg-white p-10 text-center text-sm text-slate-500">
                    {showArchived
                        ? 'Ez dago artxibatutako proiekturik.'
                        : 'Ez dago proiekturik oraindik. Sortu zure lehena hasteko!'}
                </p>
            )}
        </div>
    </section>
</AdminLayout>

<script>
    document
        .querySelectorAll<HTMLButtonElement>('.copy-code-btn')
        .forEach((button) => {
            const feedback =
                button.querySelector<HTMLElement>('.copy-feedback');
            const copyIcon =
                button.querySelector<HTMLElement>('[data-copy-icon]');
            const checkIcon =
                button.querySelector<HTMLElement>('[data-copy-check]');
            const code = button.dataset.accessCode;
            if (!feedback || !copyIcon || !checkIcon || !code) return;
            const label = button.getAttribute('aria-label') || 'Kopiatu kodea';
            let resetTimer: number | undefined;

            button.addEventListener('click', async () => {
                window.clearTimeout(resetTimer);
                button.disabled = true;
                button.setAttribute('aria-label', label);
                button.title = 'Kopiatzen…';
                copyIcon.removeAttribute('hidden');
                checkIcon.setAttribute('hidden', '');
                feedback.textContent = 'Kopiatzen…';
                try {
                    await navigator.clipboard.writeText(code);
                    copyIcon.setAttribute('hidden', '');
                    checkIcon.removeAttribute('hidden');
                    feedback.textContent = 'Kopiatuta!';
                    button.setAttribute('aria-label', 'Kodea kopiatuta');
                    button.title = 'Kodea kopiatuta';
                } catch {
                    feedback.textContent =
                        'Ezin izan da kopiatu. Saiatu berriro.';
                    button.title = feedback.textContent;
                } finally {
                    button.disabled = false;
                    resetTimer = window.setTimeout(() => {
                        feedback.textContent = '';
                        copyIcon.removeAttribute('hidden');
                        checkIcon.setAttribute('hidden', '');
                        button.setAttribute('aria-label', label);
                        button.title = 'Kopiatu kodea';
                    }, 1500);
                }
            });
        });

    const menus =
        document.querySelectorAll<HTMLDetailsElement>('.project-menu');
    document.addEventListener('click', (event) => {
        menus.forEach((menu) => {
            if (event.target instanceof Node && !menu.contains(event.target))
                menu.open = false;
        });
    });
    menus.forEach((menu) => {
        menu.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && menu.open) {
                menu.open = false;
                menu.querySelector('summary')?.focus();
            }
        });
    });

    document
        .querySelectorAll<HTMLButtonElement>('.project-action-btn')
        .forEach((button) => {
            button.addEventListener('click', async () => {
                const action = button.dataset.action;
                const projectId = Number(button.dataset.projectId);
                const projectName = button.dataset.projectName;
                if (
                    action !== 'archive' &&
                    action !== 'restore' &&
                    action !== 'delete'
                )
                    return;
                const message =
                    action === 'delete'
                        ? `Ezabatu "${projectName}" betiko? Proiektua, parte-hartzaileak, jatorrizko proiektuko erantzunak eta uneko taldeak ezabatuko dira. Ikasleen datatutako historia, berretsitako esleipenak eta jatorriaren datuak gordeko dira. Ezin da desegin.`
                        : action === 'archive'
                          ? `Artxibatu "${projectName}"? Datuak mantenduko dira eta proiektua leheneratu ahal izango duzu. Inkestarako esteka zaharrak baliogabetuko dira.`
                          : `Leheneratu "${projectName}"? Aurreko egoerara itzuliko da; egoera ezezaguna bada, prestaketara. Inkestarako esteka berriak sortu beharko dira.`;
                if (!confirm(message)) return;
                const menu = button.closest('details');
                if (menu) menu.open = false;
                const feedback = document.getElementById(
                    'project-action-feedback',
                );
                const controls = button
                    .closest('article')
                    ?.querySelectorAll<HTMLButtonElement>(
                        '.project-action-btn',
                    );
                controls?.forEach((control) => (control.disabled = true));
                if (feedback) {
                    feedback.setAttribute('role', 'status');
                    feedback.textContent = 'Aldaketa gordetzen…';
                }
                try {
                    const response = await fetch(
                        action === 'delete'
                            ? '/api/admin/delete-project'
                            : '/api/admin/archive-project',
                        {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                projectId,
                                action,
                                ...(action === 'delete'
                                    ? { confirmed: true }
                                    : {}),
                            }),
                        },
                    );
                    const result = await response.json();
                    if (!response.ok)
                        throw new Error(
                            result.error || 'Ezin izan da aldaketa gorde.',
                        );
                    const url = new URL(window.location.href);
                    url.searchParams.set('feedback', action);
                    window.location.assign(url.toString());
                } catch (caught) {
                    if (feedback) {
                        feedback.setAttribute('role', 'alert');
                        feedback.textContent =
                            caught instanceof Error
                                ? caught.message
                                : 'Ezin izan da aldaketa gorde. Saiatu berriro.';
                    }
                    controls?.forEach((control) => (control.disabled = false));
                }
            });
        });
</script>
