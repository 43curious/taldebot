---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import CollectionSurvey from '../../components/CollectionSurvey';
import { db } from '../../lib/db';
import {
    teacherSurveyTarget,
    teacherSurveyReturn,
} from '../../lib/teacherSurveyTarget';
import { teacherSurveyContext } from '../../lib/teacherSurvey';
import { language } from '../../lib/i18n';
import { InputError } from '../../lib/input';
import '../../styles/survey.css';
const lang = language(Astro.url.searchParams.get('lang') || undefined);
let context;
const parsed = teacherSurveyTarget.safeParse(
    Object.fromEntries(Astro.url.searchParams),
);
let message = '';
if (parsed.success) {
    try {
        context = await teacherSurveyContext(
            db,
            Astro.locals.teacherAccess,
            parsed.data,
        );
    } catch (error) {
        message =
            error instanceof InputError
                ? error.message
                : 'Inkesta ez dago erabilgarri.';
        Astro.response.status =
            error instanceof InputError ? error.status : 500;
    }
} else {
    message = 'Inkestaren testuingurua ez da balioduna.';
    Astro.response.status = 400;
}
const back = parsed.success
    ? teacherSurveyReturn(parsed.data)
    : '/admin/dashboard';
---

<AdminLayout
    title={
        lang === 'en'
            ? 'Complete the survey on the student’s behalf'
            : 'Bete inkesta ikaslearen partez'
    }
>
    <section class="teacher-page survey-page mx-auto max-w-3xl">
        <a
            href={back}
            class="mb-5 inline-flex min-h-11 items-center text-sm text-teal-700"
        >
            ← {lang === 'en' ? 'Back' : 'Itzuli'}
        </a>
        {context && parsed.success ? (
            <>
                <header class="mb-6">
                    <p class="text-xs text-slate-500">
                        {parsed.data.kind === 'period' && lang === 'en'
                            ? 'Student follow-up'
                            : context.title}{' '}
                        · {context.description}
                    </p>
                    <h1 class="mt-2">{context.studentName}</h1>
                    <p class="mt-3 text-sm text-slate-600">
                        {lang === 'en'
                            ? 'Complete the survey on this student’s behalf. Your name will be recorded with the answers.'
                            : 'Bete inkesta ikaslearen partez. Zure izena erantzunekin batera gordeko da.'}
                    </p>
                    <nav
                        class="mt-3 flex gap-4 text-sm text-teal-700"
                        aria-label={lang === 'en' ? 'Language' : 'Hizkuntza'}
                    >
                        <a
                            aria-current={lang === 'eu' ? 'page' : undefined}
                            href={`${Astro.url.pathname}?${new URLSearchParams({ ...Object.fromEntries(Astro.url.searchParams), lang: 'eu' })}`}
                        >
                            Euskara
                        </a>
                        <a
                            aria-current={lang === 'en' ? 'page' : undefined}
                            href={`${Astro.url.pathname}?${new URLSearchParams({ ...Object.fromEntries(Astro.url.searchParams), lang: 'en' })}`}
                        >
                            English
                        </a>
                    </nav>
                </header>
                <CollectionSurvey
                    client:load
                    questions={context.questions}
                    peers={context.peers}
                    studentId={context.studentId}
                    token=""
                    lang={lang}
                    teacherTarget={parsed.data}
                    teacherReturn={back}
                    initialEmail={context.email}
                    initialPreferences={context.initialPreferences}
                />
            </>
        ) : (
            <p role="alert" class="teacher-panel p-5 text-sm text-slate-600">
                {message}
            </p>
        )}
    </section>
</AdminLayout>
