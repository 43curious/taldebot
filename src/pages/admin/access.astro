---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import { db } from '../../lib/db';
import {
    users,
    classes,
    degrees,
    teacherResponsibilities,
} from '../../../db/schema';
import { eq, asc } from 'drizzle-orm';
import { z } from 'zod';
import { positiveId } from '../../lib/input';
let feedback = '';
let error = '';
let submitted: FormData | undefined;
if (Astro.request.method === 'POST') {
    try {
        const form = await Astro.request.formData();
        submitted = form;
        const input = z
            .object({
                userId: positiveId,
                degrees: z.array(positiveId),
                classes: z.array(positiveId),
            })
            .parse({
                userId: form.get('userId'),
                degrees: form.getAll('degreeId'),
                classes: form.getAll('classId'),
            });
        const teacher = await db.query.users.findFirst({
            where: eq(users.id, input.userId),
        });
        if (!teacher || teacher.role === 'master')
            throw new Error('Aukeratu irakasle kontu bat.');
        await db.transaction(async (tx) => {
            await tx
                .delete(teacherResponsibilities)
                .where(eq(teacherResponsibilities.userId, teacher.id));
            const grants = [
                ...input.degrees.map((degreeId) => ({
                    userId: teacher.id,
                    degreeId,
                    classId: null,
                })),
                ...input.classes.map((classId) => ({
                    userId: teacher.id,
                    degreeId: null,
                    classId,
                })),
            ];
            if (grants.length)
                await tx.insert(teacherResponsibilities).values(grants);
        });
        feedback = 'Egungo irakaskuntza-baimenak eguneratu dira.';
    } catch {
        error =
            'Ezin izan dira baimenak eguneratu. Egiaztatu hautatutako irakaslea, graduak eta klaseak.';
    }
}
const [teachers, allDegrees, allClasses, grants] = await Promise.all([
    db.query.users.findMany(),
    db.select().from(degrees).orderBy(asc(degrees.name)),
    db.select().from(classes).orderBy(asc(classes.year)),
    db.query.teacherResponsibilities.findMany(),
]);
---

<AdminLayout title="Irakasleen baimenak">
    <section class="teacher-page">
        <h1>Irakasleen baimenak</h1>
        <p class="mt-2 text-sm text-slate-500">
            Egungo gradu/klase ardurak etengabeko jarraipenaren sarbidea ematen
            du. Aurreko ardurek ez dute sarbiderik mantentzen.
        </p>
        {feedback && (
            <p role="status" class="mt-4 text-sm text-teal-700">
                {feedback}
            </p>
        )}
        {error && (
            <p role="alert" class="mt-4 text-sm text-red-700">
                {error}
            </p>
        )}
        <div class="mt-6 space-y-4">
            {teachers.map((teacher) => (
                <details
                    class="teacher-panel"
                    open={Boolean(
                        error &&
                        submitted?.get('userId') === String(teacher.id),
                    )}
                >
                    <summary class="cursor-pointer p-5 text-sm font-semibold text-slate-800">
                        {teacher.fullName || teacher.username}
                        <span class="ml-3 text-xs font-normal text-slate-500">
                            {teacher.role === 'master'
                                ? 'Master · sarbide osoa'
                                : `${grants.filter((grant) => grant.userId === teacher.id).length} ardura`}
                        </span>
                    </summary>
                    {teacher.role !== 'master' && (
                        <form
                            method="POST"
                            class="border-t border-slate-100 p-5"
                        >
                            <input
                                type="hidden"
                                name="userId"
                                value={teacher.id}
                            />
                            <fieldset>
                                <legend class="teacher-label">
                                    Gradu osoak
                                </legend>
                                <div class="mt-3 flex flex-wrap gap-4">
                                    {allDegrees.map((degree) => (
                                        <label class="flex min-h-11 items-center gap-2 text-sm">
                                            <input
                                                type="checkbox"
                                                name="degreeId"
                                                value={degree.id}
                                                checked={
                                                    error &&
                                                    submitted?.get('userId') ===
                                                        String(teacher.id)
                                                        ? submitted
                                                              .getAll(
                                                                  'degreeId',
                                                              )
                                                              .includes(
                                                                  String(
                                                                      degree.id,
                                                                  ),
                                                              )
                                                        : grants.some(
                                                              (grant) =>
                                                                  grant.userId ===
                                                                      teacher.id &&
                                                                  grant.degreeId ===
                                                                      degree.id,
                                                          )
                                                }
                                            />
                                            {degree.name}
                                        </label>
                                    ))}
                                </div>
                            </fieldset>
                            <fieldset class="mt-5">
                                <legend class="teacher-label">
                                    Klase jakinak
                                </legend>
                                <div class="mt-3 grid gap-2 sm:grid-cols-2">
                                    {allClasses.map((group) => (
                                        <label class="flex min-h-11 items-center gap-2 text-sm">
                                            <input
                                                type="checkbox"
                                                name="classId"
                                                value={group.id}
                                                checked={
                                                    error &&
                                                    submitted?.get('userId') ===
                                                        String(teacher.id)
                                                        ? submitted
                                                              .getAll('classId')
                                                              .includes(
                                                                  String(
                                                                      group.id,
                                                                  ),
                                                              )
                                                        : grants.some(
                                                              (grant) =>
                                                                  grant.userId ===
                                                                      teacher.id &&
                                                                  grant.classId ===
                                                                      group.id,
                                                          )
                                                }
                                            />
                                            {allDegrees.find(
                                                (degree) =>
                                                    degree.id ===
                                                    group.degreeId,
                                            )?.name || 'Gradurik gabe'}{' '}
                                            · {group.name}
                                        </label>
                                    ))}
                                </div>
                            </fieldset>
                            <button class="teacher-button teacher-button-primary mt-5">
                                Baimenak gorde
                            </button>
                        </form>
                    )}
                </details>
            ))}
        </div>
        <p class="mt-6 text-xs text-slate-500">
            Irakaslearen oharrak eta murrizketen arrazoiak egilearentzat eta
            masterrentzat dira. Partekatutako jarraipenak ez ditu erakusten.
        </p>
    </section>
</AdminLayout>
