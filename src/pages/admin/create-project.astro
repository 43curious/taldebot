---
export const prerender = false;
import { db } from '../../lib/db';
import {
    classes,
    degrees,
    classMembers,
    classGroups,
    classGroupMembers,
} from '../../../db/schema';
import { classFilter } from '../../lib/access';
import { eq, inArray, and, isNull } from 'drizzle-orm';
const access = Astro.locals.teacherAccess;
const groups = await db
    .select({
        id: classes.id,
        name: classes.name,
        year: classes.year,
        degreeId: classes.degreeId,
        degreeName: degrees.name,
    })
    .from(classes)
    .leftJoin(degrees, eq(classes.degreeId, degrees.id))
    .where(classFilter(access));
const members = await db.query.classMembers.findMany({
    where: inArray(
        classMembers.classId,
        groups.map((group) => group.id),
    ),
});
const moduleGroups = await db.query.classGroups.findMany({
    where: and(
        inArray(
            classGroups.classId,
            groups.map((group) => group.id),
        ),
        isNull(classGroups.archivedAt),
    ),
});
const groupMembers = moduleGroups.length
    ? await db.query.classGroupMembers.findMany({
          where: and(
              inArray(
                  classGroupMembers.groupId,
                  moduleGroups.map((group) => group.id),
              ),
              isNull(classGroupMembers.leftAt),
          ),
      })
    : [];
const initialDegree =
    Astro.url.searchParams.get('degree') === 'none'
        ? '0'
        : Astro.url.searchParams.get('degree');
const initialClass = groups.find(
    (group) => String(group.id) === Astro.url.searchParams.get('class'),
);
const initialGroup = moduleGroups.find(
    (group) =>
        group.classId === initialClass?.id &&
        String(group.id) === Astro.url.searchParams.get('group'),
);
const roster = members.filter(
    (row) =>
        row.studentRecordId !== null &&
        groups.some((group) => group.id === row.classId),
);
const degreeOptions = [
    ...new Map(
        groups.map((group) => [
            group.degreeId ?? 0,
            {
                id: group.degreeId ?? 0,
                name: group.degreeName || 'Gradurik gabe',
            },
        ]),
    ).values(),
];
import AdminLayout from '../../layouts/AdminLayout.astro';
import { classOptionLabel } from '../../lib/classSelection';
const initialSpecialty =
    initialClass &&
    ['sormena', 'digitala'].includes(Astro.url.searchParams.get('group') || '')
        ? Astro.url.searchParams.get('group')
        : null;
---

<AdminLayout title="Proiektu berria">
    <section class="teacher-page" aria-labelledby="create-project-heading">
        <header class="mb-6">
            <h1 id="create-project-heading">Proiektu berria</h1>
            <p class="mt-2 text-sm text-slate-500">
                Aukeratu parte-hartzaileak eta prestatu jarduera. Taldeak gero
                osatu eta berretsi daitezke.
            </p>
        </header>
        <form
            id="create-project-form"
            action="/api/admin/create-project"
            method="POST"
            class="space-y-5"
        >
            <section
                class="teacher-panel p-4 sm:p-5"
                aria-label="Proiektuaren datuak"
            >
                <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                    <label class="teacher-label" for="name">
                        Proiektuaren izena
                        <input
                            type="text"
                            name="name"
                            id="name"
                            required
                            placeholder="Adibidez, azken film laburra"
                        />
                    </label>
                    <label class="teacher-label" for="adminEmail">
                        Harremanetarako emaila
                        <input
                            type="email"
                            name="adminEmail"
                            id="adminEmail"
                            required
                            value={Astro.locals.teacher.email || ''}
                            autocomplete="email"
                        />
                    </label>
                    <label class="teacher-label" for="numTeams">
                        Talde kopurua
                        <input
                            type="number"
                            name="numTeams"
                            id="numTeams"
                            min="1"
                            required
                            placeholder="Adibidez, 5"
                        />
                    </label>
                </div>
            </section>
            <div class="flex items-center gap-3 rounded-xl border border-teal-700 bg-teal-700 px-4 py-4 text-white sm:px-5">
                <svg
                    class="h-5 w-5 shrink-0"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M22 21v-2a4 4 0 0 0-3-3.87" />
                    <circle cx="9" cy="7" r="4" />
                    <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                </svg>
                <p
                    id="previewText"
                    class="text-sm"
                    role="status"
                    aria-live="polite"
                >
                    0 ikasle. Aukeratu baliozko talde kopurua.
                </p>
            </div>
            <section
                class="teacher-panel p-4 sm:p-5"
                aria-labelledby="participants-heading"
            >
                <h2 id="participants-heading" class="mb-4 text-base">
                    Parte-hartzaileak
                </h2>
                <div
                    class="teacher-tabs participant-source-tabs mb-4"
                    role="tablist"
                    aria-label="Parte-hartzaileen iturria"
                >
                    <button
                        type="button"
                        role="tab"
                        id="tab-roster"
                        aria-controls="roster-entry-container"
                        aria-selected="true"
                        tabindex="0"
                    >
                        Klaseko zerrenda
                    </button>
                    <button
                        type="button"
                        role="tab"
                        id="tab-manual"
                        aria-controls="manual-entry-container"
                        aria-selected="false"
                        tabindex="-1"
                    >
                        Eskuz sartu
                    </button>
                    <button
                        type="button"
                        role="tab"
                        id="tab-csv"
                        aria-controls="csv-upload-container"
                        aria-selected="false"
                        tabindex="-1"
                    >
                        CSV igo
                    </button>
                </div>
                <div class="participant-source-panels">
                    <div
                        id="roster-entry-container"
                        class="participant-source-panel"
                        role="tabpanel"
                        aria-labelledby="tab-roster"
                        data-active="true"
                    >
                        <div class="grid gap-3 sm:grid-cols-3 mb-4">
                            <label class="teacher-label" for="roster-degree">
                                Gradua
                                <select id="roster-degree">
                                    <option value="">Aukeratu gradua</option>
                                    {degreeOptions.map((degree) => (
                                        <option
                                            value={degree.id}
                                            selected={
                                                String(degree.id) ===
                                                initialDegree
                                            }
                                        >
                                            {degree.name}
                                        </option>
                                    ))}
                                </select>
                            </label>
                            <label class="teacher-label" for="roster-class">
                                Klasea
                                <select id="roster-class">
                                    <option value="">Aukeratu klasea</option>
                                    {groups.map((group) => (
                                        <option
                                            value={group.id}
                                            selected={
                                                group.id === initialClass?.id
                                            }
                                            data-degree={group.degreeId ?? 0}
                                        >
                                            {classOptionLabel(group)}
                                        </option>
                                    ))}
                                </select>
                            </label>
                            <label
                                class="teacher-label"
                                for="roster-module-group"
                            >
                                Moduluko taldea
                                <select id="roster-module-group">
                                    <option value="">Klase osoa</option>
                                    <optgroup label="Espezialitatea">
                                        <option
                                            value="sormena"
                                            selected={
                                                initialSpecialty === 'sormena'
                                            }
                                        >
                                            Sormena
                                        </option>
                                        <option
                                            value="digitala"
                                            selected={
                                                initialSpecialty === 'digitala'
                                            }
                                        >
                                            Digitala
                                        </option>
                                    </optgroup>
                                    <optgroup label="Moduluko taldeak">
                                        {moduleGroups.map((group) => (
                                            <option
                                                value={group.id}
                                                data-class={group.classId}
                                                selected={
                                                    group.id ===
                                                    initialGroup?.id
                                                }
                                            >
                                                {group.moduleName} ·{' '}
                                                {group.name}
                                            </option>
                                        ))}
                                    </optgroup>
                                </select>
                            </label>
                        </div>
                        <div
                            class="divide-y divide-slate-100 max-h-80 overflow-y-auto"
                            id="roster-rows"
                        >
                            {roster.map((member) => (
                                <label
                                    class="hidden items-center gap-3 py-3 text-sm"
                                    data-roster-class={member.classId}
                                    data-roster-division={member.division || ''}
                                    data-roster-groups={JSON.stringify(
                                        groupMembers
                                            .filter(
                                                (row) =>
                                                    row.studentId ===
                                                    member.studentRecordId,
                                            )
                                            .map((row) => row.groupId),
                                    )}
                                >
                                    <input
                                        type="checkbox"
                                        data-roster-id={member.studentRecordId!}
                                        data-name={member.name}
                                        data-email={member.email || ''}
                                    />
                                    <span class="min-w-0 break-words">
                                        {member.name}
                                        <small class="block text-xs text-slate-500 break-all">
                                            {member.email}
                                        </small>
                                    </span>
                                </label>
                            ))}
                        </div>
                        <p
                            id="roster-empty"
                            class="py-3 text-sm text-slate-500"
                        >
                            Aukeratu gradua eta klasea ikasleak ikusteko.
                        </p>
                        <p
                            id="roster-status"
                            role="status"
                            aria-live="polite"
                            class="mt-3 text-xs text-slate-500"
                        ></p>
                        <p class="mt-2 text-xs text-slate-500">
                            Klasea edo taldea hautatzean, ikasle guztiak
                            aukeratzen dira. Kendu parte hartuko ez dutenen
                            marka.
                        </p>
                    </div>
                    <div
                        id="manual-entry-container"
                        class="participant-source-panel"
                        role="tabpanel"
                        aria-labelledby="tab-manual"
                        aria-hidden="true"
                        data-active="false"
                        inert
                    >
                        <label class="teacher-label" for="studentList">
                            Ikasleen izenak, bat lerro bakoitzeko
                            <textarea
                                id="studentList"
                                name="studentList"
                                rows="6"
                                placeholder="Ane Agirre&#10;Iker Etxeberria"
                                class="w-full"
                            ></textarea>
                        </label>
                        <p class="mt-2 text-xs text-slate-500">
                            Izen anbiguoak ez dira automatikoki lotzen.
                            Identitatea argitzeko, erabili emaildun CSV bat edo
                            klaseko zerrenda.
                        </p>
                    </div>
                    <div
                        id="csv-upload-container"
                        class="participant-source-panel"
                        role="tabpanel"
                        aria-labelledby="tab-csv"
                        aria-hidden="true"
                        data-active="false"
                        inert
                    >
                        <label class="teacher-label" for="csv-file">
                            CSV fitxategia
                            <input
                                id="csv-file"
                                type="file"
                                accept=".csv"
                                aria-describedby="csv-help"
                                class="w-full"
                            />
                        </label>
                        <p id="csv-help" class="mt-2 text-xs text-slate-500">
                            Zutabeak: izena, emaila (edo name, email).
                        </p>
                        <div id="csv-preview" hidden class="mt-3">
                            <p class="mb-2 text-xs text-slate-500">
                                <span id="csv-count">0</span> ikasle aurkitu
                                dira · Lehen 10 errenkadak
                            </p>
                            <div class="max-h-40 overflow-auto">
                                <table class="w-full text-left text-xs">
                                    <thead>
                                        <tr class="text-slate-500">
                                            <th scope="col" class="p-2">
                                                Izena
                                            </th>
                                            <th scope="col" class="p-2">
                                                Emaila
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody
                                        id="csv-preview-body"
                                        class="divide-y divide-slate-100"
                                    ></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <input type="hidden" name="studentsJson" id="studentsJson" />
                <input type="hidden" name="classGroupId" id="classGroupId" />
            </section>
            <details class="teacher-panel">
                <summary class="cursor-pointer p-4 sm:p-5 text-sm text-slate-600">
                    Deskribapena eta inkesta bidezko talde-irizpidea
                </summary>
                <div class="space-y-4 border-t border-slate-100 p-4 sm:p-5">
                    <label class="teacher-label" for="description">
                        Deskribapena
                        <textarea
                            id="description"
                            name="description"
                            rows="3"
                            class="w-full"
                        ></textarea>
                    </label>
                    <label class="teacher-label" for="projectType">
                        Inkesta bidezko taldeak osatzeko irizpidea
                        <select id="projectType" name="projectType">
                            <option value="balanced">Orekatua</option>
                            <option value="technical">Teknikoa</option>
                            <option value="narrative">Narratiba</option>
                            <option value="management">Kudeaketa</option>
                        </select>
                    </label>
                    <p class="text-xs text-slate-500">
                        Ausazko edo eskuzko taldeak osatzeko aukera proiektuaren
                        Taldeak orrian dago.
                    </p>
                </div>
            </details>

            <p
                id="create-project-feedback"
                class="text-sm text-red-700"
                role="alert"
                tabindex="-1"
                hidden
            ></p>
            <div class="teacher-toolbar">
                <button
                    type="submit"
                    class="teacher-button teacher-button-primary"
                >
                    Proiektua sortu
                </button>
                <a href="/admin/dashboard" class="teacher-button">
                    Utzi
                </a>
            </div>
        </form>
    </section>
    <script>
        import Papa from 'papaparse';
        const form = document.querySelector<HTMLFormElement>(
            '#create-project-form',
        )!;
        const text = form.querySelector<HTMLTextAreaElement>('#studentList')!;
        const json = form.querySelector<HTMLInputElement>('#studentsJson')!;
        const degree = form.querySelector<HTMLSelectElement>('#roster-degree')!;
        const group = form.querySelector<HTMLSelectElement>('#roster-class')!;
        const moduleGroup = form.querySelector<HTMLSelectElement>(
            '#roster-module-group',
        )!;
        const groupId = form.querySelector<HTMLInputElement>('#classGroupId')!;
        const empty = form.querySelector<HTMLElement>('#roster-empty')!;
        const rosterStatus = form.querySelector<HTMLElement>('#roster-status')!;
        const feedback = form.querySelector<HTMLElement>(
            '#create-project-feedback',
        )!;
        let participantCount = 0;
        const count = form.querySelector<HTMLInputElement>('#numTeams')!;
        const preview = document.getElementById('previewText')!;
        const sourceNames = ['roster', 'manual', 'csv'] as const;
        let source: (typeof sourceNames)[number] = 'roster';
        let csv: { name: string; email: string }[] = [];
        const rosterInputs = Array.from(
            form.querySelectorAll<HTMLInputElement>('[data-roster-id]'),
        );
        function update() {
            const selectedRows = rosterInputs
                .filter((row) => row.checked && !row.disabled)
                .map((row) => ({
                    studentRecordId: Number(row.dataset.rosterId),
                    name: row.dataset.name,
                    email: row.dataset.email || undefined,
                }));
            const selected = [
                ...new Map(
                    selectedRows.map((row) => [row.studentRecordId, row]),
                ).values(),
            ];
            moduleGroup.disabled = source !== 'roster' || !group.value;
            const namedGroup = Number(moduleGroup.value);
            groupId.value =
                Number.isSafeInteger(namedGroup) && namedGroup > 0
                    ? String(namedGroup)
                    : '';
            groupId.disabled = source !== 'roster';
            degree.required = source === 'roster';
            group.required = source === 'roster';
            text.required = source === 'manual';
            text.disabled = source !== 'manual';
            json.disabled = source === 'manual';
            json.value = JSON.stringify(source === 'roster' ? selected : csv);
            const total =
                source === 'roster'
                    ? selected.length
                    : source === 'csv'
                      ? csv.length
                      : text.value.split('\n').filter((row) => row.trim())
                            .length;
            participantCount = total;
            const visibleCount = rosterInputs.filter(
                (row) => !row.disabled,
            ).length;
            rosterStatus.textContent = group.value
                ? `${selected.length} / ${visibleCount} ikasle aukeratuta`
                : '';
            const teams = Number(count.value);
            preview.textContent =
                !total || !Number.isInteger(teams) || teams < 1 || teams > total
                    ? `${total} ikasle. Aukeratu baliozko talde kopurua.`
                    : `${total} ikasle · ${teams} talde · ${Math.floor(total / teams)}–${Math.ceil(total / teams)} kide taldeko.`;
            for (const name of sourceNames) {
                const container = document.getElementById(
                    name === 'roster'
                        ? 'roster-entry-container'
                        : name === 'manual'
                          ? 'manual-entry-container'
                          : 'csv-upload-container',
                )!;
                const active = name === source;
                container.dataset.active = String(active);
                container.inert = !active;
                container.setAttribute('aria-hidden', String(!active));
                const tab = document.getElementById(`tab-${name}`)!;
                tab.setAttribute('aria-selected', String(active));
                tab.tabIndex = active ? 0 : -1;
            }
        }
        sourceNames.forEach((name, index) => {
            const tab = document.getElementById(`tab-${name}`)!;
            tab.addEventListener('click', () => {
                source = name;
                update();
            });
            tab.addEventListener('keydown', (event) => {
                const direction =
                    event.key === 'ArrowRight'
                        ? 1
                        : event.key === 'ArrowLeft'
                          ? -1
                          : 0;
                if (!direction && event.key !== 'Home' && event.key !== 'End')
                    return;
                event.preventDefault();
                const next =
                    event.key === 'Home'
                        ? 0
                        : event.key === 'End'
                          ? sourceNames.length - 1
                          : (index + direction + sourceNames.length) %
                            sourceNames.length;
                source = sourceNames[next];
                update();
                document.getElementById(`tab-${source}`)!.focus();
            });
        });
        rosterInputs.forEach((row) => row.addEventListener('change', update));
        text.addEventListener('input', update);
        count.addEventListener('input', update);
        function filterRoster(selectMembers = false) {
            form.querySelectorAll<HTMLElement>('[data-roster-class]').forEach(
                (row) => {
                    const visible =
                        row.dataset.rosterClass === group.value &&
                        (moduleGroup.value === 'sormena' ||
                        moduleGroup.value === 'digitala'
                            ? row.dataset.rosterDivision === moduleGroup.value
                            : !moduleGroup.value ||
                              JSON.parse(
                                  row.dataset.rosterGroups || '[]',
                              ).includes(Number(moduleGroup.value)));
                    row.classList.toggle('hidden', !visible);
                    row.classList.toggle('flex', visible);
                    const checkbox =
                        row.querySelector<HTMLInputElement>('input')!;
                    checkbox.disabled = !visible;
                    if (!visible) checkbox.checked = false;
                    else if (selectMembers) checkbox.checked = true;
                },
            );
            const visibleCount = rosterInputs.filter(
                (row) => !row.disabled,
            ).length;
            empty.hidden = visibleCount > 0;
            empty.textContent = !degree.value
                ? 'Aukeratu gradua ikasleak ikusteko.'
                : !group.value
                  ? 'Aukeratu klasea ikasleak ikusteko.'
                  : moduleGroup.value
                    ? 'Hautatutako taldeak ez du ikaslerik klase honetan.'
                    : 'Klase honetan ez dago parte-hartzaile erabilgarririk.';
            update();
        }
        function filterGroups() {
            for (const option of moduleGroup.options)
                if (option.value) {
                    option.hidden = Boolean(
                        option.dataset.class &&
                        option.dataset.class !== group.value,
                    );
                    option.disabled = !group.value || option.hidden;
                }
        }
        function filterClasses() {
            group.disabled = !degree.value;
            for (const option of group.options)
                if (option.value) {
                    option.hidden = option.dataset.degree !== degree.value;
                    option.disabled = option.hidden;
                }
        }
        degree.addEventListener('change', () => {
            group.value = '';
            moduleGroup.value = '';
            filterClasses();
            filterGroups();
            filterRoster();
        });
        group.addEventListener('change', () => {
            moduleGroup.value = '';
            filterGroups();
            filterRoster(true);
        });
        moduleGroup.addEventListener('change', () => filterRoster(true));
        form.querySelector<HTMLInputElement>('#csv-file')!.addEventListener(
            'change',
            (event) => {
                const file = (event.target as HTMLInputElement).files?.[0];
                if (!file) return;
                Papa.parse<Record<string, string>>(file, {
                    header: true,
                    skipEmptyLines: true,
                    complete: (result) => {
                        csv = result.data
                            .map((row) => ({
                                name: (row.name || row.izena || '').trim(),
                                email: (row.email || row.emaila || '').trim(),
                            }))
                            .filter((row) => row.name);
                        const body =
                            document.getElementById('csv-preview-body')!;
                        body.replaceChildren();
                        csv.slice(0, 10).forEach((row) => {
                            const tr = document.createElement('tr');
                            for (const value of [row.name, row.email]) {
                                const td = document.createElement('td');
                                td.className = 'px-3 py-2';
                                td.textContent = value;
                                tr.append(td);
                            }
                            body.append(tr);
                        });
                        document.getElementById('csv-count')!.textContent =
                            String(csv.length);
                        document.getElementById('csv-preview')!.hidden = false;
                        update();
                    },
                });
            },
        );
        filterClasses();
        if (group.selectedOptions[0]?.disabled) group.value = '';
        filterGroups();
        if (moduleGroup.selectedOptions[0]?.disabled) moduleGroup.value = '';
        filterRoster(Boolean(group.value));
        update();
        form.addEventListener('submit', async (event) => {
            event.preventDefault();
            update();
            const button = form.querySelector<HTMLButtonElement>(
                'button[type="submit"]',
            )!;
            if (button.disabled) return;
            feedback.hidden = true;
            if (!participantCount) {
                feedback.textContent =
                    'Aukeratu gutxienez ikasle bat proiektua sortzeko.';
                feedback.hidden = false;
                feedback.focus();
                return;
            }
            const label = button.textContent;
            button.disabled = true;
            button.textContent = 'Sortzen…';
            try {
                const response = await fetch(form.action, {
                    method: 'POST',
                    body: new FormData(form),
                });
                if (!response.ok || !response.redirected) {
                    const data = await response.json();
                    throw new Error(
                        data.error === 'Invalid input'
                            ? 'Egiaztatu proiektuaren datuak eta saiatu berriro.'
                            : data.error || 'Ezin izan da proiektua sortu.',
                    );
                }
                window.location.assign(response.url);
            } catch (error) {
                feedback.textContent =
                    error instanceof Error
                        ? error.message
                        : 'Ezin izan da proiektua sortu.';
                feedback.hidden = false;
                feedback.focus();
                button.disabled = false;
                button.textContent = label;
            }
        });
    </script>
</AdminLayout>

<style>
    @media (max-width: 640px) {
        .participant-source-tabs {
            flex-wrap: nowrap;
        }
        .participant-source-tabs button {
            flex: 1;
            justify-content: center;
            min-width: 0;
            padding: 0.5rem;
            font-size: 0.75rem;
        }
    }
    .participant-source-panels {
        display: grid;
    }
    .participant-source-panel {
        grid-area: 1 / 1;
        min-width: 0;
    }
    .participant-source-panel[data-active='false'] {
        visibility: hidden;
        pointer-events: none;
    }

    #roster-rows input[type='checkbox'] {
        width: 1rem;
        height: 1rem;
