---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import UserAccountFields from '../../components/UserAccountFields.astro';
import { db } from '../../lib/db';
import { classes, degrees, users } from '../../../db/schema';
import { asc } from 'drizzle-orm';
import { requireMaster } from '../../lib/access';
import {
    accountSchema,
    createUser,
    updateUser,
    deleteUser,
} from '../../lib/userManagement';
import { InputError, positiveId } from '../../lib/input';
const access = Astro.locals.teacherAccess;
requireMaster(access);
let error = '',
    feedback = '';
let submitted: FormData | undefined;
if (Astro.request.method === 'POST') {
    submitted = await Astro.request.formData();
    try {
        const action = submitted.get('action');
        if (action === 'create' || action === 'update') {
            const input = accountSchema.parse({
                username: submitted.get('username'),
                fullName: submitted.get('fullName'),
                email: submitted.get('email'),
                role: submitted.get('role'),
                degreeIds: submitted.getAll('degreeId'),
                classIds: submitted.getAll('classId'),
            });
            if (action === 'create') {
                await createUser(db, access, {
                    ...input,
                    password: String(submitted.get('password') || ''),
                });
                feedback = 'Erabiltzailea eta bere ardurak sortu dira.';
            } else {
                await updateUser(
                    db,
                    access,
                    positiveId.parse(submitted.get('userId')),
                    input,
                );
                feedback = 'Kontua, rola eta ardurak eguneratu dira.';
            }
        } else if (action === 'delete') {
            await deleteUser(
                db,
                access,
                positiveId.parse(submitted.get('userId')),
            );
            feedback = 'Erabiltzailea ezabatu da.';
        } else throw new InputError('Ekintza ezezaguna.');
    } catch (caught) {
        error =
            caught instanceof InputError
                ? caught.message
                : 'Ezin izan dira aldaketak gorde. Egiaztatu kontuaren datuak eta hautatutako ardurak.';
    }
}
const [accounts, allDegrees, allClasses, grants] = await Promise.all([
    db.query.users.findMany({
        columns: { hashedPassword: false },
        orderBy: asc(users.username),
    }),
    db.select().from(degrees).orderBy(asc(degrees.name)),
    db.select().from(classes).orderBy(asc(classes.year), asc(classes.name)),
    db.query.teacherResponsibilities.findMany(),
]);
const draft = (account?: (typeof accounts)[number]) => {
    const keep =
        error &&
        (account
            ? submitted?.get('action') === 'update' &&
              submitted?.get('userId') === String(account.id)
            : submitted?.get('action') === 'create');
    return {
        username: keep
            ? String(submitted?.get('username') || '')
            : account?.username || '',
        fullName: keep
            ? String(submitted?.get('fullName') || '')
            : account?.fullName || '',
        email: keep
            ? String(submitted?.get('email') || '')
            : account?.email || '',
        role: keep
            ? String(submitted?.get('role') || '')
            : account?.role || 'admin',
        degreeIds: keep
            ? submitted!.getAll('degreeId').map(String)
            : grants
                  .filter(
                      (grant) =>
                          grant.userId === account?.id &&
                          grant.degreeId !== null,
                  )
                  .map((grant) => String(grant.degreeId)),
        classIds: keep
            ? submitted!.getAll('classId').map(String)
            : grants
                  .filter(
                      (grant) =>
                          grant.userId === account?.id &&
                          grant.classId !== null,
                  )
                  .map((grant) => String(grant.classId)),
    };
};
const responsibilityNames = (id: number) =>
    grants
        .filter((grant) => grant.userId === id)
        .map((grant) =>
            grant.degreeId !== null
                ? allDegrees.find((degree) => degree.id === grant.degreeId)
                      ?.name
                : allClasses.find((group) => group.id === grant.classId)?.name,
        )
        .filter(Boolean)
        .join(' · ');
---

<AdminLayout title="Erabiltzaileen kudeaketa">
    <section class="teacher-page" aria-labelledby="users-heading">
        <h1 id="users-heading">Erabiltzaileen kudeaketa</h1>
        <p class="mt-2 text-sm text-slate-500">
            Kontuak eta egungo gradu/klase ardurak leku berean kudeatu.
        </p>
        {error && (
            <p role="alert" class="mt-4 text-sm text-red-700">
                {error}
            </p>
        )}
        {feedback && (
            <p role="status" class="mt-4 text-sm text-teal-700">
                {feedback}
            </p>
        )}
        <div class="teacher-panel mt-6 divide-y divide-slate-100">
            {accounts.map((account) => (
                <details
                    open={Boolean(
                        error &&
                        submitted?.get('userId') === String(account.id),
                    )}
                >
                    <summary class="cursor-pointer p-4">
                        <span class="text-sm font-medium text-slate-800">
                            {account.fullName || account.username}
                        </span>
                        <span class="ml-3 text-xs text-slate-500">
                            {account.role === 'master'
                                ? 'Master · Sarbide osoa'
                                : 'Irakaslea'}
                            {account.id === access.actor.id && ' · Zu'}
                        </span>
                        <span class="mt-1 block break-words text-xs text-slate-500">
                            {account.username}
                            {account.email && ` · ${account.email}`}
                        </span>
                        {account.role === 'admin' && (
                            <span class="mt-1 block break-words text-xs text-slate-500">
                                {responsibilityNames(account.id) ||
                                    'Gradu/klase ardurarik gabe'}
                            </span>
                        )}
                    </summary>
                    <div class="border-t border-slate-100 p-4">
                        <form method="POST">
                            <input type="hidden" name="action" value="update" />
                            <input
                                type="hidden"
                                name="userId"
                                value={account.id}
                            />
                            <UserAccountFields
                                account={draft(account)}
                                allDegrees={allDegrees}
                                allClasses={allClasses}
                                self={account.id === access.actor.id}
                            />
                            <button class="teacher-button teacher-button-primary mt-4">
                                Aldaketak gorde
                            </button>
                        </form>
                        {account.id !== access.actor.id && (
                            <form
                                method="POST"
                                class="mt-4"
                                onsubmit="return confirm('Erabiltzaile hau ezabatu? Egiletza duen kontua mantendu egingo da.')"
                            >
                                <input
                                    type="hidden"
                                    name="action"
                                    value="delete"
                                />
                                <input
                                    type="hidden"
                                    name="userId"
                                    value={account.id}
                                />
                                <button class="teacher-button text-red-700">
                                    Kontua ezabatu
                                </button>
                            </form>
                        )}
                    </div>
                </details>
            ))}
        </div>
        <details
            class="teacher-panel mt-5"
            open={Boolean(error && submitted?.get('action') === 'create')}
        >
            <summary class="cursor-pointer p-4 text-sm font-medium text-slate-700">
                Erabiltzaile berria
            </summary>
            <form method="POST" class="border-t border-slate-100 p-4">
                <input type="hidden" name="action" value="create" />
                <UserAccountFields
                    account={draft()}
                    allDegrees={allDegrees}
                    allClasses={allClasses}
                    creating
                />
                <button class="teacher-button teacher-button-primary mt-4">
                    Erabiltzailea sortu
                </button>
            </form>
        </details>
    </section>
</AdminLayout>
