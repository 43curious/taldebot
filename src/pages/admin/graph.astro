---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import ClassSelector from '../../components/ClassSelector.astro';
import ClassGraph from '../../components/ClassGraph';
import { db } from '../../lib/db';
import {
    classes,
    classMembers,
    degrees,
    studentRecords,
    students,
    surveyCollections,
    surveyResponses,
    confirmedAssignments,
} from '../../../db/schema';
import {
    asc,
    eq,
    inArray,
    and,
    desc,
    lte,
    getTableColumns,
    count,
    sql,
} from 'drizzle-orm';
import { requireSurvey, surveyVisibility } from '../../lib/surveyCollections';
import { positiveId, routeError, InputError } from '../../lib/input';
import type { PreferenceKind } from '../../lib/trackingTypes';
import type { GraphAssignment } from '../../lib/sociogram';
import { selectClassScope } from '../../lib/classSelection';
import { classFilter, projectFilter, isMaster } from '../../lib/access';
import {
    knowledgeSourceLabel,
    projectSourceLabel,
} from '../../lib/knowledgeContext';
import { loadStudentProfiles } from '../../lib/studentProfiles';
import type { GraphStudent } from '../../lib/studentReport';
import type { Relationship } from '../../lib/tracking';
const access = Astro.locals.teacherAccess;
const classSizes = db
    .select({
        classId: classMembers.classId,
        studentCount: count().as('student_count'),
    })
    .from(classMembers)
    .innerJoin(
        studentRecords,
        eq(studentRecords.id, classMembers.studentRecordId),
    )
    .groupBy(classMembers.classId)
    .as('class_sizes');
const [allDegrees, allClasses, projects] = await Promise.all([
    db
        .select()
        .from(degrees)
        .where(
            isMaster(access)
                ? undefined
                : inArray(degrees.id, [...access.degreeIds]),
        )
        .orderBy(asc(degrees.name)),
    db
        .select({
            ...getTableColumns(classes),
            studentCount: sql<number>`coalesce(${classSizes.studentCount}, 0)`,
        })
        .from(classes)
        .leftJoin(classSizes, eq(classSizes.classId, classes.id))
        .where(classFilter(access))
        .orderBy(asc(classes.year), asc(classes.name)),
    db.query.projects.findMany({
        where: projectFilter(access),
        orderBy: (row, { desc }) => [desc(row.createdAt)],
    }),
]);
const scope = selectClassScope(allDegrees, allClasses, Astro.url.searchParams);
const selectedRoster = scope.selectedClass
    ? eq(classMembers.classId, scope.selectedClass.id)
    : inArray(classMembers.classId, []);
const [roster, participants, surveyOptions] = await Promise.all([
    db
        .select({
            id: studentRecords.id,
            classId: classMembers.classId,
            name: studentRecords.name,
            email: studentRecords.email,
            tutor: classMembers.tutor,
            division: classMembers.division,
        })
        .from(classMembers)
        .innerJoin(
            studentRecords,
            eq(studentRecords.id, classMembers.studentRecordId),
        )
        .where(selectedRoster)
        .orderBy(asc(studentRecords.name)),
    db.query.students.findMany({
        where: inArray(
            students.studentRecordId,
            db
                .select({ id: classMembers.studentRecordId })
                .from(classMembers)
                .where(selectedRoster),
        ),
    }),
    db.query.surveyCollections.findMany({
        where: and(
            surveyVisibility(db, access),
            scope.selectedClass
                ? eq(surveyCollections.classId, scope.selectedClass.id)
                : inArray(surveyCollections.id, []),
        ),
        orderBy: desc(surveyCollections.launchedAt),
    }),
]);
const rosterIds = new Set(roster.map((member) => member.id));
const projectOptions = projects.filter((project) =>
    participants.some((student) => student.projectId === project.id),
);
let sourceSurvey: Awaited<ReturnType<typeof requireSurvey>> | undefined;
try {
    if (Astro.url.searchParams.get('survey')) {
        sourceSurvey = await requireSurvey(
            db,
            access,
            positiveId.parse(Astro.url.searchParams.get('survey')),
        );
        if (sourceSurvey.survey.classId !== scope.selectedClass?.id)
            throw new InputError('Inkesta beste klase batekoa da.', 403);
    }
} catch (error) {
    return routeError(error);
}
const source = sourceSurvey
    ? projects.find((project) => project.id === sourceSurvey.survey.projectId)
    : projectOptions.find(
          (project) =>
              String(project.id) === Astro.url.searchParams.get('project'),
      );
const historical =
    !sourceSurvey &&
    !source &&
    Astro.url.searchParams.get('project') !== 'current';
const asOf = Astro.url.searchParams.get('asOf') || undefined;
if (
    asOf &&
    (!/^\d{4}-\d{2}-\d{2}$/.test(asOf) || Number.isNaN(Date.parse(asOf)))
)
    return new Response('Invalid date', { status: 400 });
const profiles = await loadStudentProfiles(db, access, [...rosterIds], {
    projectId: source?.id,
    surveyId: sourceSurvey?.survey.id,
    academicPeriod:
        sourceSurvey?.survey.academicPeriod ??
        source?.academicPeriod ??
        undefined,
    asOf,
    relationshipView: historical ? 'latest-recorded' : undefined,
});
const collectionAnswers = sourceSurvey
    ? await db.query.surveyResponses.findMany({
          where: eq(surveyResponses.surveyId, sourceSurvey.survey.id),
          columns: { studentId: true, submittedAt: true },
      })
    : [];
const completedIds = new Set(
    collectionAnswers
        .filter((row) => !asOf || row.submittedAt <= `${asOf}T23:59:59.999Z`)
        .map((row) => row.studentId),
);
const nodes: GraphStudent[] = roster.flatMap((member) => {
    const profile = profiles.get(member.id);
    if (!profile) return [];
    const participant = source
        ? participants.find(
              (row) =>
                  row.projectId === source.id &&
                  row.studentRecordId === member.id,
          )
        : undefined;
    if (!sourceSurvey && source && participant?.isExcluded) return [];
    return [
        {
            ...member,
            hasSurvey: Boolean(
                profile.assessment ||
                profile.relationshipPreference ||
                completedIds.has(member.id),
            ),
            hasCompleted: sourceSurvey
                ? completedIds.has(member.id)
                : (participant?.hasCompleted ?? null),
            isExcluded: false,
            assessment: profile.assessment ? profile.values : undefined,
            profile: {
                label: sourceSurvey
                    ? `${sourceSurvey.survey.name} · v${sourceSurvey.version.version} · ${profile.period}`
                    : source
                      ? `${source.name} · ${profile.period}`
                      : historical
                        ? 'Azken harreman-erantzunak · Historia'
                        : `Egungo ikasturteko hobespenak · ${profile.period}`,
                assessmentAt: profile.assessment?.submittedAt ?? null,
                assessmentVersion:
                    profile.assessment?.questionnaireVersion ?? null,
                memberships: profile.enrollments
                    .filter((row) => !row.endedAt)
                    .map((row) => ({
                        className: row.currentClassName ?? row.className,
                        year: row.currentYear ?? row.year,
                        academicPeriod: row.academicPeriod,
                    })),
                preferenceKinds: (
                    Object.keys(profile.preferenceCoverage) as PreferenceKind[]
                ).filter((kind) => Boolean(profile.preferenceCoverage[kind])),
                collaborations: profile.collaborations,

                assessmentSource: profile.assessment
                    ? knowledgeSourceLabel(profile.assessment)
                    : null,
                preferenceAt:
                    profile.relationshipPreference?.submittedAt ?? null,
                needsReview: profile.needsReview,
                relationships: profile.relationships,
                assignedPeerIds: [
                    ...new Set(
                        profile.assignments.flatMap((row) =>
                            row.peers.flatMap((peer) =>
                                peer.id === null ? [] : [peer.id],
                            ),
                        ),
                    ),
                ],
                assignments: profile.assignments.slice(0, 5).map((row) => ({
                    projectName: row.projectName,
                    date: row.confirmedAt,
                    revision: row.revision,
                    peers: row.peers.map((peer) => peer.name),
                    peerIds: row.peers.flatMap((peer) =>
                        peer.id === null ? [] : [peer.id],
                    ),
                })),
                href: `/admin/students/${member.id}?${new URLSearchParams({ ...(sourceSurvey ? { survey: String(sourceSurvey.survey.id) } : {}), project: source ? String(source.id) : historical ? '' : 'current', ...(asOf ? { asOf } : {}) })}`,
                motivationInContext: Boolean(source),
                inSurveyAudience: sourceSurvey
                    ? sourceSurvey.audience.some(
                          (row) => row.studentId === member.id,
                      )
                    : undefined,
            },
        },
    ];
});
const visible = new Set(nodes.map((node) => node.id));
const dedup = new Set<string>();
const links: Relationship[] = [...profiles.values()].flatMap((profile) =>
    profile.relationships
        .filter(
            (link) =>
                !link.incoming &&
                visible.has(link.source) &&
                visible.has(link.target),
        )
        .flatMap((link) => {
            const key =
                link.kind === 'restriction'
                    ? `restriction:${[link.source, link.target].sort((a, b) => a - b).join(':')}`
                    : `${link.source}:${link.target}:${link.kind}`;
            if (dedup.has(key)) return [];
            dedup.add(key);
            return [
                { source: link.source, target: link.target, kind: link.kind },
            ];
        }),
);
let assignment: GraphAssignment | null = null;
if (source) {
    const confirmed = await db.query.confirmedAssignments.findFirst({
        where: and(
            eq(confirmedAssignments.projectId, source.id),
            asOf
                ? lte(confirmedAssignments.confirmedAt, `${asOf}T23:59:59.999Z`)
                : undefined,
        ),
        orderBy: desc(confirmedAssignments.revision),
    });
    if (confirmed)
        assignment = {
            projectName: confirmed.projectName,
            confirmedAt: confirmed.confirmedAt,
            revision: confirmed.revision,
            teams: confirmed.allocation
                .map((team) => ({
                    teamNumber: team.teamNumber,
                    studentIds: team.studentIds.filter((id) => visible.has(id)),
                }))
                .filter((team) => team.studentIds.length),
        };
}
const sourceLabel = `${sourceSurvey ? `${sourceSurvey.survey.name} · v${sourceSurvey.version.version}` : source ? projectSourceLabel(source) : historical ? 'Azken harreman-erantzunak · Historia' : 'Egungo ikasturteko hobespenak'}${asOf ? ` · ${asOf} arte` : ''}`;
---

<AdminLayout title="Harremanen mapa" fullScreen>
    <section class="teacher-page graph-page" aria-labelledby="graph-heading">
        <h1 id="graph-heading" class="sr-only">
            Harremanen mapa
        </h1>
        <header class="graph-page-header">
            <ClassSelector degrees={allDegrees} scope={scope} compact />
            <details class="graph-project-menu teacher-menu">
                <summary aria-label="Maparen testuingurua">
                    Testuingurua
                </summary>
                <form
                    method="GET"
                    id="graph-project-form"
                    class="teacher-menu-content"
                >
                    <input type="hidden" name="degree" value={scope.degree} />
                    <input
                        type="hidden"
                        name="class"
                        value={scope.selectedClass?.id}
                    />
                    <label for="graph-project" class="teacher-label">
                        Testuingurua
                    </label>
                    <select
                        id="graph-project"
                        name="project"
                        class="mt-2 w-full"
                    >
                        <option value="" selected={historical}>
                            Azken harreman-erantzunak · Historia
                        </option>
                        <option
                            value="current"
                            selected={!source && !historical}
                        >
                            Egungo ikasturteko hobespenak
                        </option>
                        {projectOptions.map((project) => (
                            <option
                                value={project.id}
                                selected={project.id === source?.id}
                            >
                                {projectSourceLabel(project)}
                            </option>
                        ))}
                    </select>
                    <p class="mt-2 text-xs text-slate-500">
                        Historian ikasle bakoitzaren azken bidalketa osoa
                        erakusten da, bere jatorri eta datarekin. Aurreko
                        erantzunak ez dira egungo hobespen bihurtzen. Erantzunik
                        ez izatea ez da baztertzea.
                    </p>
                    <label for="graph-survey" class="teacher-label mt-3">
                        Inkesta
                    </label>
                    <select id="graph-survey" name="survey" class="mt-2 w-full">
                        <option value="">Inkesta jakinik gabe</option>
                        {surveyOptions.map((survey) => (
                            <option
                                value={survey.id}
                                selected={survey.id === sourceSurvey?.survey.id}
                            >
                                {survey.name} · {survey.academicPeriod}
                            </option>
                        ))}
                    </select>
                    <label for="graph-as-of" class="teacher-label mt-3">
                        Historia-data
                    </label>
                    <input
                        type="date"
                        id="graph-as-of"
                        name="asOf"
                        value={asOf}
                        class="mt-2 w-full"
                    />
                    <button class="teacher-button mt-3">Ikusi</button>
                </form>
            </details>
        </header>
        <div class="graph-page-canvas">
            {scope.selectedClass ? (
                <ClassGraph
                    client:load
                    fullScreen
                    students={nodes.filter((student) => !student.isExcluded)}
                    relationships={links}
                    sourceLabel={sourceLabel}
                    noSurvey={nodes.every((node) => !node.hasSurvey)}
                    assignment={assignment}
                    activitySelected={Boolean(source || sourceSurvey)}
                />
            ) : (
                <div class="graph-page-empty">
                    <p class="text-sm text-slate-500">
                        {allDegrees.length
                            ? 'Gradu honek ez du klaserik oraindik.'
                            : 'Ez dago gradurik oraindik.'}
                    </p>
                    <a
                        href={`/admin/classes?mode=edit&degree=${scope.degree}`}
                        class="mt-4 inline-flex min-h-11 items-center text-sm text-teal-700"
                    >
                        Klaseak kudeatu →
                    </a>
                </div>
            )}
        </div>
    </section>
</AdminLayout>
<style>
    .graph-page {
        height: 100%;
        display: flex;
        flex-direction: column;
        padding: 0;
    }
    .graph-page-header {
        position: relative;
        z-index: 25;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 16px 24px;
        border-bottom: 1px solid #e2e8f0;
        background: #fff;
    }
    .graph-page-header :global(.graph-scope) {
        width: min(100%, 680px);
    }
    .graph-page-canvas {
        flex: 1;
        min-height: 0;
        position: relative;
    }
    .graph-page-canvas :global(astro-island) {
        display: block;
        height: 100%;
    }
    .graph-project-menu {
        margin-left: auto;
        flex-shrink: 0;
    }
    .graph-page-empty {
        display: grid;
        place-content: center;
        text-align: center;
        height: 100%;
        padding: 24px;
    }
    @media (max-width: 1023px) {
        .graph-page-header {
            padding-left: 72px;
            padding-right: 16px;
        }
    }
    @media (max-width: 639px) {
        .graph-page-header {
            gap: 8px;
            align-items: flex-start;
            padding: 12px 12px 12px 64px;
        }
        .graph-page-header :global(.graph-scope) {
            gap: 8px;
        }
        .graph-page-header :global(select) {
            width: 100%;
            padding-right: 24px;
            font-size: 12px;
        }
        .graph-project-menu {
            position: absolute;
            top: 62px;
            left: 12px;
            margin: 0;
        }
        .graph-project-menu :global(summary) {
            font-size: 10px;
            padding: 4px;
        }
        .graph-project-menu :global(.teacher-menu-content) {
            left: 0;
            right: auto;
        }
    }
</style>
<script>
    const projectForm = document.getElementById(
        'graph-project-form',
    ) as HTMLFormElement | null;
    projectForm?.querySelectorAll('select').forEach((select) =>
        select.addEventListener('change', () => {
            const project =
                projectForm.querySelector<HTMLSelectElement>(
                    '[name="project"]',
                );
            const survey =
                projectForm.querySelector<HTMLSelectElement>('[name="survey"]');
            if (select === project && survey) survey.value = '';
            if (select === survey && project) project.value = '';
            projectForm.requestSubmit();
        }),
    );
</script>
