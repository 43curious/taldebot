---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import ClassSelector from '../../components/ClassSelector.astro';
import ClassGraph from '../../components/ClassGraph';
import { db } from '../../lib/db';
import {
    classes,
    classMembers,
    degrees,
    studentRecords,
    students,
} from '../../../db/schema';
import { asc, eq, inArray } from 'drizzle-orm';
import { selectClassScope } from '../../lib/classSelection';
import { classFilter, projectFilter, isMaster } from '../../lib/access';
import { knowledgeSourceLabel } from '../../lib/knowledgeContext';
import { loadStudentProfiles } from '../../lib/studentProfiles';
import type { GraphStudent } from '../../lib/studentReport';
import type { Relationship } from '../../lib/tracking';
const access = Astro.locals.teacherAccess;
const [allDegrees, allClasses] = await Promise.all([
    db
        .select()
        .from(degrees)
        .where(
            isMaster(access)
                ? undefined
                : inArray(degrees.id, [...access.degreeIds]),
        )
        .orderBy(asc(degrees.name)),
    db
        .select()
        .from(classes)
        .where(classFilter(access))
        .orderBy(asc(classes.year), asc(classes.name)),
]);
const members = await db
    .select({
        id: studentRecords.id,
        classId: classMembers.classId,
        name: studentRecords.name,
        email: studentRecords.email,
        tutor: classMembers.tutor,
        division: classMembers.division,
    })
    .from(classMembers)
    .innerJoin(
        studentRecords,
        eq(studentRecords.id, classMembers.studentRecordId),
    )
    .where(
        inArray(
            classMembers.classId,
            allClasses.map((group) => group.id),
        ),
    )
    .orderBy(asc(studentRecords.name));
const counts = new Map<number, number>();
for (const member of members)
    counts.set(member.classId, (counts.get(member.classId) ?? 0) + 1);
const scope = selectClassScope(
    allDegrees,
    allClasses.map((group) => ({
        ...group,
        studentCount: counts.get(group.id) ?? 0,
    })),
    Astro.url.searchParams,
);
const roster = members.filter(
    (member) => member.classId === scope.selectedClass?.id,
);
const rosterIds = new Set(roster.map((member) => member.id));
const projects = await db.query.projects.findMany({
    where: projectFilter(access),
    orderBy: (row, { desc }) => [desc(row.createdAt)],
});
const participants = await db.query.students.findMany({
    where: inArray(students.studentRecordId, [...rosterIds]),
});
const projectOptions = projects.filter((project) =>
    participants.some((student) => student.projectId === project.id),
);
const source = projectOptions.find(
    (project) => String(project.id) === Astro.url.searchParams.get('project'),
);
const asOf = Astro.url.searchParams.get('asOf') || undefined;
if (
    asOf &&
    (!/^\d{4}-\d{2}-\d{2}$/.test(asOf) || Number.isNaN(Date.parse(asOf)))
)
    return new Response('Invalid date', { status: 400 });
const profiles = await loadStudentProfiles(db, access, [...rosterIds], {
    projectId: source?.id,
    academicPeriod: source?.academicPeriod ?? undefined,
    asOf,
});
const nodes: GraphStudent[] = roster.flatMap((member) => {
    const profile = profiles.get(member.id);
    if (!profile) return [];
    const participant = source
        ? participants.find(
              (row) =>
                  row.projectId === source.id &&
                  row.studentRecordId === member.id,
          )
        : undefined;
    if (source && participant?.isExcluded) return [];
    return [
        {
            ...member,
            hasSurvey: Boolean(profile.assessment),
            hasCompleted: participant?.hasCompleted ?? null,
            isExcluded: false,
            assessment: profile.assessment ? profile.values : undefined,
            profile: {
                label: source
                    ? `${source.name} · ${profile.period}`
                    : `Etengabeko jarraipena · ${profile.period}`,
                assessmentAt: profile.assessment?.submittedAt ?? null,
                assessmentSource: profile.assessment
                    ? knowledgeSourceLabel(profile.assessment)
                    : null,
                preferenceAt: profile.preference?.submittedAt ?? null,
                needsReview: profile.needsReview,
                relationships: profile.relationships,
                assignments: profile.assignments.slice(0, 5).map((row) => ({
                    projectName: row.projectName,
                    date: row.confirmedAt,
                    revision: row.revision,
                })),
                href: `/admin/students/${member.id}`,
                motivationInContext: Boolean(source),
            },
        },
    ];
});
const visible = new Set(nodes.map((node) => node.id));
const dedup = new Set<string>();
const links: Relationship[] = [...profiles.values()].flatMap((profile) =>
    profile.relationships
        .filter(
            (link) =>
                !link.incoming &&
                visible.has(link.source) &&
                visible.has(link.target),
        )
        .flatMap((link) => {
            const key =
                link.kind === 'restriction'
                    ? `restriction:${[link.source, link.target].sort((a, b) => a - b).join(':')}`
                    : `${link.source}:${link.target}:${link.kind}`;
            if (dedup.has(key)) return [];
            dedup.add(key);
            return [
                { source: link.source, target: link.target, kind: link.kind },
            ];
        }),
);
const sourceLabel = `${source ? source.name : 'Etengabeko jarraipena'}${asOf ? ` · ${asOf} arte` : ''}`;
---

<AdminLayout title="Harremanen mapa" fullScreen>
    <section class="teacher-page graph-page" aria-labelledby="graph-heading">
        <h1 id="graph-heading" class="sr-only">
            Harremanen mapa
        </h1>
        <header class="graph-page-header">
            <ClassSelector degrees={allDegrees} scope={scope} compact />
            <details class="graph-project-menu teacher-menu">
                <summary aria-label="Maparen testuingurua">
                    Testuingurua
                </summary>
                <form
                    method="GET"
                    id="graph-project-form"
                    class="teacher-menu-content"
                >
                    <input type="hidden" name="degree" value={scope.degree} />
                    <input
                        type="hidden"
                        name="class"
                        value={scope.selectedClass?.id}
                    />
                    <label for="graph-project" class="teacher-label">
                        Testuingurua
                    </label>
                    <select
                        id="graph-project"
                        name="project"
                        class="mt-2 w-full"
                    >
                        <option value="">Etengabeko jarraipena</option>
                        {projectOptions.map((project) => (
                            <option
                                value={project.id}
                                selected={project.id === source?.id}
                            >
                                {project.name}
                            </option>
                        ))}
                    </select>
                    <label for="graph-as-of" class="teacher-label mt-3">
                        Historia-data
                    </label>
                    <input
                        type="date"
                        id="graph-as-of"
                        name="asOf"
                        value={asOf}
                        class="mt-2 w-full"
                    />
                    <button class="teacher-button mt-3">Ikusi</button>
                </form>
            </details>
        </header>
        <div class="graph-page-canvas">
            {scope.selectedClass ? (
                <ClassGraph
                    client:load
                    fullScreen
                    students={nodes.filter((student) => !student.isExcluded)}
                    relationships={links}
                    sourceLabel={sourceLabel}
                    noSurvey={nodes.every((node) => !node.hasSurvey)}
                />
            ) : (
                <div class="graph-page-empty">
                    <p class="text-sm text-slate-500">
                        {allDegrees.length
                            ? 'Gradu honek ez du klaserik oraindik.'
                            : 'Ez dago gradurik oraindik.'}
                    </p>
                    <a
                        href={`/admin/classes?mode=edit&degree=${scope.degree}`}
                        class="mt-4 inline-flex min-h-11 items-center text-sm text-teal-700"
                    >
                        Klaseak kudeatu →
                    </a>
                </div>
            )}
        </div>
    </section>
</AdminLayout>
<style>
    .graph-page {
        height: 100%;
        display: flex;
        flex-direction: column;
        padding: 0;
    }
    .graph-page-header {
        position: relative;
        z-index: 25;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 16px 24px;
        border-bottom: 1px solid #e2e8f0;
        background: #fff;
    }
    .graph-page-header :global(.graph-scope) {
        width: min(100%, 680px);
    }
    .graph-page-canvas {
        flex: 1;
        min-height: 0;
        position: relative;
    }
    .graph-page-canvas :global(astro-island) {
        display: block;
        height: 100%;
    }
    .graph-project-menu {
        margin-left: auto;
        flex-shrink: 0;
    }
    .graph-page-empty {
        display: grid;
        place-content: center;
        text-align: center;
        height: 100%;
        padding: 24px;
    }
    @media (max-width: 1023px) {
        .graph-page-header {
            padding-left: 72px;
            padding-right: 16px;
        }
    }
    @media (max-width: 639px) {
        .graph-page-header {
            gap: 8px;
            align-items: flex-start;
            padding: 12px 12px 12px 64px;
        }
        .graph-page-header :global(.graph-scope) {
            gap: 8px;
        }
        .graph-page-header :global(select) {
            width: 100%;
            padding-right: 24px;
            font-size: 12px;
        }
        .graph-project-menu {
            position: absolute;
            top: 62px;
            left: 12px;
            margin: 0;
        }
        .graph-project-menu :global(summary) {
            font-size: 10px;
            padding: 4px;
        }
        .graph-project-menu :global(.teacher-menu-content) {
            left: 0;
            right: auto;
        }
    }
</style>
<script>
    const projectForm = document.getElementById(
        'graph-project-form',
    ) as HTMLFormElement | null;
    projectForm
        ?.querySelector('select')
        ?.addEventListener('change', () => projectForm.requestSubmit());
</script>
