---
export const prerender = false;
import StudentSurvey from '../../../../components/StudentSurvey.astro';
import StudentAccess from '../../../../components/StudentAccess.astro';
import { loadProjectSurvey } from '../../../../lib/survey';
import { studentPath, t } from '../../../../lib/i18n';
const lang = 'en';
const result = await loadProjectSurvey(
    Astro.params.projectId,
    Astro.url.searchParams.get('token'),
);
if (!result) return Astro.redirect(studentPath(lang, '/?error=not_found'));
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
---

{result.context && result.token ? (
    <StudentSurvey
        {...result.data}
        lang={lang}
        initialStudentId={String(result.context.request.participantId)}
        requestToken={result.token}
    />
) : (
    <StudentAccess
        lang={lang}
        title={result.data.project.name}
        message={result.invalid ? t(lang).form.personalLinkError : undefined}
    />
)}
