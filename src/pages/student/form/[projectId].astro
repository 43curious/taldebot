---
export const prerender = false;
import StudentSurvey from '../../../components/StudentSurvey.astro';
import { loadSurvey } from '../../../lib/survey';
import { studentPath } from '../../../lib/i18n';
const lang = 'eu';
const data = await loadSurvey(Astro.params.projectId);
if (!data) return Astro.redirect(studentPath(lang, '/?error=not_found'));
---
<StudentSurvey {...data} lang={lang} initialStudentId={Astro.url.searchParams.get('studentId')} />
