---
export const prerender = false;
import IndependentUpdate from '../../../components/IndependentUpdate.astro';
import StudentAccess from '../../../components/StudentAccess.astro';
import { requestContext } from '../../../lib/studentUpdates';
import { db } from '../../../lib/db';
import { t } from '../../../lib/i18n';
const lang = 'eu';
const token = Astro.params.token || '';
let context;
try {
    context = await requestContext(db, token);
    if (context.request.scope !== 'period') context = undefined;
} catch {
    context = undefined;
}
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
if (!context) Astro.response.status = 410;
---

{context ? (
    <IndependentUpdate lang={lang} token={token} context={context} />
) : (
    <StudentAccess
        lang={lang}
        title={t(lang).form.title}
        message={t(lang).form.personalLinkError}
    />
)}
